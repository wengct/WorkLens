@page "/"
@page "/today"
@inject WorkLogService WorkLogs
@inject ActivityQueryService Activities
@inject ManualSourceService ManualSources
@inject SourceConfigurationService SourceConfig
@inject ReportService Reports
@inject AiConfigurationService AiConfigurations
@inject WorkDraftService Drafts
@inject RuntimeSettingsService RuntimeSettings
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toasts
@implements IAsyncDisposable

<PageTitle>工作填寫｜WorkLens</PageTitle>
<NavigationLock OnBeforeInternalNavigation="BeforeNavigationAsync" />
<div class="today-page-stack">

<div class="page-heading">
    <div>
        <p class="eyebrow">Daily workspace</p>
        <h1>@selectedDate.ToString("yyyy/MM/dd") 工作台</h1>
        <p>隨手記下工作；來源活動會自動補充當日脈絡。</p>
    </div>
    <div class="button-row">
        <button class="button button-secondary" @onclick="PreviousDay">← 前一天</button>
        <button class="button button-secondary" @onclick="GoToday">今天</button>
        <button class="button button-secondary" @onclick="NextDay">後一天 →</button>
    </div>
</div>

@{ var confirmedHours = WorkLogService.CalculateHours(entries); }
<div class="stats-grid today-stats" aria-label="當日概況">
    <a class="stat-card stat-card-link" href="#today-records"><div class="stat-label">確認工時</div><div class="stat-value @(confirmedHours > 8 ? "text-danger" : null)">@confirmedHours.ToString("0.##")</div><div class="stat-note">查看人工紀錄</div></a>
    <a class="stat-card stat-card-link" href="#today-records"><div class="stat-label">工作紀錄</div><div class="stat-value">@entries.Count</div><div class="stat-note">前往查看與編輯</div></a>
    <a class="stat-card stat-card-link" href="#source-activity"><div class="stat-label">來源活動</div><div class="stat-value">@evidence.Count</div><div class="stat-note">前往查看活動</div></a>
    <div class="stat-card">
        <div class="stat-label">每日摘要</div>
        <div class="stat-value report-state">
            <a class="today-report-link @(report is null || report.IsStale ? "today-report-pending" : null)" href="/reports?kind=Daily&date=@selectedDate.ToString("yyyy-MM-dd")" title="前往處理每日摘要">@ReportStateText()</a>
        </div>
    </div>
</div>

<div class="today-workspace">
<div id="work-input" class="panel today-quick-add">
    <div class="panel-heading">
        <div><h2>記工作與工時</h2><p>記下做了什麼、花了多少時間；日期與專案會保留，方便連續記錄。</p></div>
        <div class="button-row today-quick-actions">
            <button class="button button-secondary button-small" type="button" @onclick="OpenGettingStarted" aria-haspopup="dialog">建立摘要指南</button>
            <button class="button button-secondary" type="button" @onclick="OpenManualSourceCreateAsync">貼上參考資料</button>
        </div>
    </div>
    <WorkDraftEditor @key="QuickKey" @ref="quickEditor" Kind="WorkDraftKind.WorkCreate" Date="selectedDate"
                     Initial="QuickInitial" Projects="projects" OnSaved="ReloadAsync" OnDraftChanged="LoadDraftListAsync" OnReload="ReloadQuickAsync" OnDateChanged="NavigateAsync" />
</div>

@if (showGettingStarted)
{
    <div class="modal-backdrop" role="presentation" @onclick="CloseGettingStartedAsync">
        <section class="modal-dialog getting-started-dialog" role="dialog" aria-modal="true" aria-labelledby="getting-started-title" @onclick:stopPropagation>
            <div class="modal-heading"><div><p class="eyebrow">開始使用</p><h2 id="getting-started-title">建立第一份工作摘要</h2><p>依你已完成的設定自動勾選；不使用 AI 也能完成。</p></div><button class="modal-close" type="button" aria-label="關閉" @onclick="CloseGettingStartedAsync">×</button></div>
            <GettingStarted HasWork="@(entries.Count > 0)" HasSource="@(sources.Count > 0)" HasSourceCollection="@(sources.Any(source => source.LastSuccessAt is not null))" HasReport="hasAnyReport" HasAi="hasAiConfiguration" />
            <div class="modal-actions"><button class="button button-secondary" type="button" @onclick="DismissGettingStartedAsync">略過</button></div>
        </section>
    </div>
}

<div id="today-records" class="panel today-records">
    <div class="panel-heading"><div><h2>工作紀錄</h2><p>會計入確認工時；修改會讓相關報告標示為需要重產。</p></div></div>
    @if (draftList.Count > 0)
    {
        <details class="unfinished-drafts">
            <summary><strong>未完成草稿（@draftList.Count）</strong></summary>
            <ul>
                @foreach (var item in draftList)
                {
                    <li><button type="button" class="button button-secondary button-small" @onclick="() => ResumeDraftAsync(item)">@item.Date.ToString("yyyy/MM/dd") · @DraftKindText(item.Kind)</button> <span>@item.UpdatedAt.ToLocalTime().ToString("MM/dd HH:mm") 暫存</span></li>
                }
            </ul>
        </details>
    }
    @if (entries.Count == 0)
    {
        <div class="empty-state"><h3>這天還沒有紀錄</h3><p>可直接補登過去日期的工作內容。</p></div>
    }
    else
    {
        <div class="timeline">
            @foreach (var entry in entries)
            {
                <div class="timeline-item">
                    <div class="timeline-time">@entry.Hours.ToString("0.##") 小時 · @ProjectName(entry.ProjectId)</div>
                    <div class="timeline-title">@entry.Title</div>
                    <div class="timeline-detail markdown-source">@entry.WorkContent</div>
                    <div class="button-row" style="margin-top: 8px">
                        <button class="button button-secondary button-small" @onclick="() => BeginEditAsync(entry)">編輯</button>
                        <button class="button button-secondary button-small" @onclick="() => CopyAsync(entry)">複製</button>
                        <button class="button button-danger button-small" @onclick="() => pendingDeleteId = entry.Id">刪除</button>
                    </div>
                </div>
            }
        </div>
    }
</div>
</div>

<SourceStatusSummary Sources="sources" Date="selectedDate" ActivityCount="evidence.Count" />
@if (!string.IsNullOrEmpty(sourceRefreshError))
{
    <p class="alert alert-warning" role="status">@sourceRefreshError</p>
}
<details id="source-activity" class="panel evidence-panel">
    <summary><strong>參考資料與來源活動（@evidence.Count）</strong> · 自動納入當日報告</summary>
    <ul class="source-health-list">
        @foreach (var source in sources)
        {
            <li><strong>@source.DisplayName</strong> · @SourceStatusSummary.StateText(source)
                <span>最近成功：@(source.LastSuccessAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "尚無成功紀錄")</span>
            </li>
        }
    </ul>
    @if (evidence.Count == 0)
    {
        <p class="muted">此日期尚無已匯入的來源活動。</p>
    }
    else
    {
        <div class="timeline">
            @foreach (var item in evidence)
            {
                <div class="timeline-item" @key="item.Id">
                    <div class="timeline-time">@item.OccurredAt.ToLocalTime().ToString("HH:mm") · @ProjectName(item.ProjectId)</div>
                    <div class="timeline-title">@item.Title</div>
                    <div class="timeline-detail">
                        @if (item.Kind == EvidenceKind.CodexSession)
                        {
                            <CodexSessionDetails Evidence="item" />
                        }
                        else if (item.Kind == EvidenceKind.ClaudeCodeSession)
                        {
                            <ClaudeCodeSessionDetails Evidence="item" />
                        }
                        else if (item.Kind == EvidenceKind.CopilotSession)
                        {
                            <CopilotSessionDetails Evidence="item" />
                        }
                        else if (item.Kind is EvidenceKind.AzureDevOpsPullRequestCreated or EvidenceKind.AzureDevOpsPullRequestClosed)
                        {
                            <AzureDevOpsPullRequestDetails Evidence="item" />
                        }
                        else
                        {
                            @item.RepositoryKey
                            @if (!string.IsNullOrWhiteSpace(item.CommitMessage) && item.CommitMessage != item.Title)
                            {
                                @if (item.Kind == EvidenceKind.Manual)
                                {
                                    <details class="manual-source-details">
                                        <summary>內容明細</summary>
                                        <div class="markdown-source">@item.CommitMessage</div>
                                    </details>
                                }
                                else
                                {
                                    <div class="markdown-source">@item.CommitMessage</div>
                                }
                            }
                            @if (item.Kind == EvidenceKind.Manual)
                            {
                                <div class="button-row" style="margin-top: 8px">
                                    <button class="button button-secondary button-small" @onclick="() => BeginManualSourceEditAsync(item)">編輯</button>
                                    <button class="button button-danger button-small" @onclick="() => pendingManualDeleteId = item.Id">刪除</button>
                                </div>
                                }
                            }
                    </div>
                </div>
            }
        </div>
    }
</details>

@if (activeKind is WorkDraftKind modalKind)
{
    <div class="modal-backdrop" role="presentation" @onclick="CloseModalAsync">
        <section class="modal-dialog modal-dialog-wide" role="dialog" aria-modal="true" aria-labelledby="draft-modal-title" @onclick:stopPropagation>
            <div class="modal-heading"><h2 id="draft-modal-title">@DraftKindText(modalKind)</h2><button class="modal-close" type="button" aria-label="關閉並保留草稿" @onclick="CloseModalAsync">×</button></div>
            <WorkDraftEditor @key="ModalKey" @ref="modalEditor" Kind="modalKind" Date="selectedDate" TargetId="activeTargetId"
                             Initial="modalInitial" Projects="projects" OnSaved="ModalSavedAsync" OnClose="HideModalAsync"
                             OnDraftChanged="LoadDraftListAsync" OnReload="ReloadModalAsync" OnDateChanged="@(modalKind == WorkDraftKind.ManualCreate ? EventCallback.Factory.Create<DateOnly>(this, NavigateManualDateAsync) : default)" />
        </section>
    </div>
}

<ConfirmDialog Open="pendingDeleteId is not null"
               Title="刪除這筆工作紀錄？"
               Message="刪除後，相關摘要會標示為需要重產；這筆工作紀錄無法復原。"
               ConfirmText="確認刪除"
               BusyText="刪除中…"
               IsBusy="isDeleting"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDelete" />

<ConfirmDialog Open="pendingManualDeleteId is not null"
               Title="刪除這筆參考資料？"
               Message="這筆資料不計入工時。刪除後，相關摘要會標示為需要重產，且無法復原。"
               ConfirmText="確認刪除"
               BusyText="刪除中…"
               IsBusy="isDeleting"
               OnConfirm="ConfirmManualSourceDeleteAsync"
               OnCancel="CancelManualSourceDelete" />

</div>

@code {
    [SupplyParameterFromQuery(Name = "date")] public DateTime? RequestedDate { get; set; }
    [SupplyParameterFromQuery(Name = "draft")] public string? RequestedDraft { get; set; }
    [SupplyParameterFromQuery(Name = "compose")] public string? RequestedCompose { get; set; }
    private DateOnly selectedDate;
    private IReadOnlyList<WorkEntry> entries = [];
    private IReadOnlyList<SourceEvidence> evidence = [];
    private IReadOnlyList<Project> projects = [];
    private IReadOnlyList<ActivitySource> sources = [];
    private IReadOnlyList<WorkDraft> draftList = [];
    private ReportDocument? report;
    private bool hasAnyReport;
    private bool hasAiConfiguration;
    private bool showGettingStarted;
    private bool gettingStartedOpenedAutomatically;
    private bool automaticGettingStartedRecorded;
    private WorkDraftEditor? quickEditor;
    private WorkDraftEditor? modalEditor;
    private WorkDraftKind? activeKind;
    private Guid? activeTargetId;
    private WorkDraftInput modalInitial = new();
    private Guid? pendingDeleteId;
    private Guid? pendingManualDeleteId;
    private bool isDeleting;
    private string sourceRefreshError = "";
    private int quickGeneration;
    private int modalGeneration;
    private readonly CancellationTokenSource lifetime = new();
    private Task? refreshTask;
    private string QuickKey => $"{selectedDate}:{quickGeneration}";
    private string ModalKey => $"{selectedDate}:{activeKind}:{activeTargetId}:{modalGeneration}";
    private WorkDraftInput QuickInitial => new() { Date = selectedDate.ToString("yyyy-MM-dd") };

    protected override async Task OnParametersSetAsync()
    {
        selectedDate = DateOnly.FromDateTime(RequestedDate ?? DateTime.Today);
        activeKind = null;
        await ReloadAsync();
        await LoadDraftListAsync();
        if (RequestedCompose == "manual") await OpenManualSourceCreateAsync();
        if (RequestedDraft is not null)
        {
            var requested = draftList.FirstOrDefault(x => x.Id == RequestedDraft);
            if (requested is not null && requested.Kind != WorkDraftKind.WorkCreate) OpenDraft(requested);
        }
    }

    protected override void OnInitialized()
    {
        if (!RuntimeSettings.IsOnboardingDismissed)
        {
            showGettingStarted = true;
            gettingStartedOpenedAutomatically = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) refreshTask = RefreshLoopAsync();
        if (gettingStartedOpenedAutomatically && !automaticGettingStartedRecorded)
        {
            automaticGettingStartedRecorded = true;
            await RuntimeSettings.SetOnboardingDismissedAsync(true);
        }
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
            {
                await InvokeAsync(async () =>
                {
                    try { await ReloadSourceStateAsync(); StateHasChanged(); }
                    catch (Exception) when (!lifetime.IsCancellationRequested)
                    {
                        sourceRefreshError = "來源狀態更新失敗，目前顯示上次結果；稍後會自動重試。";
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task ReloadSourceStateAsync()
    {
        var date = selectedDate;
        var start = new DateTimeOffset(DateTime.SpecifyKind(date.ToDateTime(TimeOnly.MinValue), DateTimeKind.Local));
        var newSources = await SourceConfig.GetSourcesAsync(lifetime.Token);
        var newEvidence = await Activities.GetForRangeAsync(start, start.AddDays(1));
        if (date != selectedDate || lifetime.IsCancellationRequested) return;
        sources = newSources;
        evidence = newEvidence;
        sourceRefreshError = "";
    }

    private async Task ReloadAsync()
    {
        projects = await SourceConfig.GetProjectsAsync();
        entries = await WorkLogs.GetForDateAsync(selectedDate);
        await ReloadSourceStateAsync();
        report = await Reports.GetForPeriodAsync(ReportKind.Daily, selectedDate.ToString("yyyy-MM-dd"));
        hasAnyReport = (await Reports.GetRecentAsync(1)).Count > 0;
        var aiSettings = await AiConfigurations.GetFeatureSettingsAsync();
        hasAiConfiguration = aiSettings.Enabled && await AiConfigurations.GetDefaultAsync() is not null;
    }

    private async Task LoadDraftListAsync() => draftList = await Drafts.ListAsync();
    private Task PreviousDay() => NavigateAsync(selectedDate.AddDays(-1));
    private Task NextDay() => NavigateAsync(selectedDate.AddDays(1));
    private Task GoToday() => NavigateAsync(DateOnly.FromDateTime(DateTime.Today));
    private Task NavigateAsync(DateOnly date) { Navigation.NavigateTo($"/?date={date:yyyy-MM-dd}"); return Task.CompletedTask; }
    private Task NavigateManualDateAsync(DateOnly date) { Navigation.NavigateTo($"/?date={date:yyyy-MM-dd}&compose=manual"); return Task.CompletedTask; }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("workLensDrafts.flushAll"))
            {
                context.PreventNavigation();
                Toasts.Error("草稿尚未暫存，請重試或先複製目前內容。");
            }
        }
        catch (JSException) { context.PreventNavigation(); Toasts.Error("無法完成草稿暫存，請先保留目前內容。"); }
    }

    private Task OpenManualSourceCreateAsync()
    {
        activeKind = WorkDraftKind.ManualCreate;
        activeTargetId = null;
        modalInitial = QuickInitial;
        modalGeneration++;
        return Task.CompletedTask;
    }
    private void OpenGettingStarted()
    {
        showGettingStarted = true;
        gettingStartedOpenedAutomatically = false;
    }
    private async Task CloseGettingStartedAsync()
    {
        if (gettingStartedOpenedAutomatically)
            await RuntimeSettings.SetOnboardingDismissedAsync(true);
        showGettingStarted = false;
        gettingStartedOpenedAutomatically = false;
    }
    private async Task DismissGettingStartedAsync()
    {
        await RuntimeSettings.SetOnboardingDismissedAsync(true);
        showGettingStarted = false;
        gettingStartedOpenedAutomatically = false;
    }
    private Task BeginEditAsync(WorkEntry entry)
    {
        activeKind = WorkDraftKind.WorkEdit;
        activeTargetId = entry.Id;
        modalInitial = QuickInitial;
        modalGeneration++;
        return Task.CompletedTask;
    }
    private Task BeginManualSourceEditAsync(SourceEvidence item)
    {
        activeKind = WorkDraftKind.ManualEdit;
        activeTargetId = item.Id;
        modalInitial = QuickInitial;
        modalGeneration++;
        return Task.CompletedTask;
    }
    private Task CloseModalAsync() => modalEditor?.CloseAsync() ?? Task.CompletedTask;
    private Task HideModalAsync() { activeKind = null; modalEditor = null; return Task.CompletedTask; }
    private async Task ModalSavedAsync() { await HideModalAsync(); await ReloadAsync(); }
    private Task ReloadQuickAsync() { quickGeneration++; return Task.CompletedTask; }
    private Task ReloadModalAsync() { modalGeneration++; return Task.CompletedTask; }
    private async Task CopyAsync(WorkEntry entry)
    {
        if (quickEditor is not null)
            await quickEditor.ReplaceAsync(new WorkDraftInput
            {
                Date = selectedDate.ToString("yyyy-MM-dd"), Hours = entry.Hours.ToString(CultureInfo.InvariantCulture),
                ProjectId = entry.ProjectId?.ToString() ?? "", Content = entry.WorkContent
            });
    }
    private void OpenDraft(WorkDraft item)
    {
        activeKind = item.Kind;
        activeTargetId = item.TargetId;
        modalInitial = QuickInitial;
        modalGeneration++;
    }
    private Task ResumeDraftAsync(WorkDraft item)
    {
        Navigation.NavigateTo($"/?date={item.Date:yyyy-MM-dd}&draft={Uri.EscapeDataString(item.Id)}");
        return Task.CompletedTask;
    }
    private static string DraftKindText(WorkDraftKind kind) => kind switch
    {
        WorkDraftKind.WorkCreate => "記工作與工時", WorkDraftKind.WorkEdit => "編輯工作紀錄",
        WorkDraftKind.ManualCreate => "貼上參考資料", _ => "編輯參考資料"
    };

    private async Task DeleteAsync(Guid id)
    {
        if (isDeleting) return;
        isDeleting = true;
        try
        {
            await WorkLogs.DeleteAsync(id);
            pendingDeleteId = null;
            Toasts.Success("工作紀錄已刪除。");
            await ReloadAsync();
        }
        finally { isDeleting = false; }
    }
    private async Task DeleteManualSourceAsync(Guid id)
    {
        if (isDeleting) return;
        isDeleting = true;
        try
        {
            await ManualSources.DeleteAsync(id);
            pendingManualDeleteId = null;
            Toasts.Success("參考資料已刪除。");
            await ReloadAsync();
        }
        finally { isDeleting = false; }
    }
    private Task ConfirmDeleteAsync() => pendingDeleteId is Guid id ? DeleteAsync(id) : Task.CompletedTask;
    private Task ConfirmManualSourceDeleteAsync() => pendingManualDeleteId is Guid id ? DeleteManualSourceAsync(id) : Task.CompletedTask;
    private void CancelDelete() => pendingDeleteId = null;
    private void CancelManualSourceDelete() => pendingManualDeleteId = null;
    private string ProjectName(Guid? id) => id is Guid projectId ? projects.FirstOrDefault(x => x.Id == projectId)?.Name ?? "已停用專案" : "未分類";
    private string ReportStateText() => report is null ? "未產生" : report.IsStale ? "需重產" : "最新";

    public async ValueTask DisposeAsync()
    {
        await lifetime.CancelAsync();
        if (refreshTask is not null) await refreshTask;
        lifetime.Dispose();
    }
}
