@page "/"
@page "/today"
@inject WorkLogService WorkLogs
@inject ActivityQueryService Activities
@inject ManualSourceService ManualSources
@inject SourceConfigurationService SourceConfig
@inject ReportService Reports
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toasts
@implements IAsyncDisposable

<PageTitle>工作填寫｜WorkLens</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Daily workspace</p>
        <h1>@selectedDate.ToString("yyyy/MM/dd") 工作台</h1>
        <p>隨手記下工作；來源活動會自動補充當日脈絡。</p>
    </div>
    <div class="button-row">
        <button class="button button-secondary" @onclick="PreviousDay">← 前一天</button>
        <button class="button button-secondary" @onclick="GoToday">今天</button>
        <button class="button button-secondary" @onclick="NextDay">後一天 →</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(editorNotice))
{
    <div class="alert alert-warning">@editorNotice</div>
}

<div class="stats-grid today-stats" aria-label="當日概況">
    <a class="stat-card stat-card-link" href="#today-records"><div class="stat-label">確認工時</div><div class="stat-value">@WorkLogService.CalculateHours(entries).ToString("0.##")</div><div class="stat-note">查看人工紀錄</div></a>
    <a class="stat-card stat-card-link" href="#today-records"><div class="stat-label">工作紀錄</div><div class="stat-value">@entries.Count</div><div class="stat-note">前往查看與編輯</div></a>
    <a class="stat-card stat-card-link" href="#source-activity"><div class="stat-label">來源活動</div><div class="stat-value">@evidence.Count</div><div class="stat-note">前往查看活動</div></a>
    <div class="stat-card"><div class="stat-label">每日摘要</div><div class="stat-value report-state">@ReportStateText()</div><div class="stat-note"><a href="/reports?kind=Daily&date=@selectedDate.ToString("yyyy-MM-dd")">前往處理</a></div></div>
</div>

<div class="today-workspace">
<div class="panel today-quick-add">
    <div class="panel-heading">
        <div><h2>快速新增</h2><p>日期與專案會保留，方便連續記錄。</p></div>
        <button class="button button-secondary" type="button" @onclick="OpenManualSourceCreateAsync">新增人工來源</button>
    </div>
    <EditForm Model="form" OnValidSubmit="SaveAsync">
        <div class="form-grid quick-add-grid">
            <div class="field"><label>日期</label><InputDate @bind-Value="form.WorkDate" @bind-Value:after="SelectFormDateAsync" /></div>
            <div class="field"><label>時數</label><InputNumber @bind-Value="form.Hours" min="0.25" max="24" step="0.25" /></div>
            <div class="field"><label>專案（選填）</label><select @bind="form.ProjectId"><option value="">未分類</option>@foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }</select></div>
            <div class="field full"><label>工作內容</label><textarea id="workContent" @bind="form.WorkContent" class="markdown-input" placeholder="用 Markdown 記下完成事項、問題或下一步…"></textarea><span class="hint">支援離線 Markdown 編輯、預覽與分欄檢視。</span></div>
            <div class="form-actions"><button class="button button-primary" type="submit">儲存紀錄</button></div>
        </div>
    </EditForm>
</div>

<div id="today-records" class="panel today-records">
    <div class="panel-heading"><div><h2>人工紀錄</h2><p>修改會讓相關報告標示為需要重產。</p></div></div>
    @if (entries.Count == 0)
    {
        <div class="empty-state"><h3>這天還沒有紀錄</h3><p>可直接補登過去日期的工作內容。</p></div>
    }
    else
    {
        <div class="timeline">
            @foreach (var entry in entries)
            {
                <div class="timeline-item">
                    <div class="timeline-time">@entry.Hours.ToString("0.##") 小時 · @ProjectName(entry.ProjectId)</div>
                    <div class="timeline-title">@entry.Title</div>
                    <div class="timeline-detail markdown-source">@entry.WorkContent</div>
                    <div class="button-row" style="margin-top: 8px">
                        <button class="button button-secondary button-small" @onclick="() => BeginEditAsync(entry)">編輯</button>
                        <button class="button button-secondary button-small" @onclick="() => CopyAsync(entry)">複製</button>
                        <button class="button button-danger button-small" @onclick="() => pendingDeleteId = entry.Id">刪除</button>
                    </div>
                </div>
            }
        </div>
    }
</div>
</div>

<details id="source-activity" class="panel evidence-panel">
    <summary><strong>來源活動（@evidence.Count）</strong> · 自動納入當日報告</summary>
    @if (evidence.Count == 0)
    {
        <p class="muted">尚未收集到此日期的來源活動。</p>
    }
    else
    {
        <div class="timeline">
            @foreach (var item in evidence)
            {
                <div class="timeline-item">
                    <div class="timeline-time">@item.OccurredAt.ToLocalTime().ToString("HH:mm") · @ProjectName(item.ProjectId)</div>
                    <div class="timeline-title">@item.Title</div>
                    <div class="timeline-detail">
                        @if (item.Kind == EvidenceKind.CodexSession)
                        {
                            <CodexSessionDetails Evidence="item" />
                        }
                        else if (item.Kind == EvidenceKind.ClaudeCodeSession)
                        {
                            <ClaudeCodeSessionDetails Evidence="item" />
                        }
                        else if (item.Kind == EvidenceKind.CopilotSession)
                        {
                            <CopilotSessionDetails Evidence="item" />
                        }
                        else if (item.Kind is EvidenceKind.AzureDevOpsPullRequestCreated or EvidenceKind.AzureDevOpsPullRequestClosed)
                        {
                            <AzureDevOpsPullRequestDetails Evidence="item" />
                        }
                        else
                        {
                            @item.RepositoryKey
                            @if (!string.IsNullOrWhiteSpace(item.CommitMessage) && item.CommitMessage != item.Title)
                            {
                                <div class="markdown-source">@item.CommitMessage</div>
                            }
                            @if (item.Kind == EvidenceKind.Manual)
                            {
                                <div class="button-row" style="margin-top: 8px">
                                    <button class="button button-secondary button-small" @onclick="() => BeginManualSourceEditAsync(item)">編輯</button>
                                    <button class="button button-danger button-small" @onclick="() => pendingManualDeleteId = item.Id">刪除</button>
                                </div>
                                }
                            }
                    </div>
                </div>
            }
        </div>
    }
</details>

@if (editingId is Guid workEntryId)
{
    <div class="modal-backdrop" role="presentation" @onclick="CancelEditAsync">
        <section class="modal-dialog modal-dialog-wide" role="dialog" aria-modal="true" aria-labelledby="work-edit-title" @onclick:stopPropagation>
            <div class="modal-heading"><div><p class="eyebrow">人工紀錄</p><h2 id="work-edit-title">編輯工作紀錄</h2></div><button class="modal-close" type="button" aria-label="關閉" @onclick="CancelEditAsync">×</button></div>
            <div class="form-grid">
                <div class="field"><label>日期</label><InputDate @bind-Value="editForm.WorkDate" /></div>
                <div class="field"><label>時數</label><InputNumber @bind-Value="editForm.Hours" min="0.25" max="24" step="0.25" /></div>
                <div class="field full"><label>專案</label><select @bind="editForm.ProjectId"><option value="">未分類</option>@foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }</select></div>
                <div class="field full"><label>標題（選填）</label><input @bind="editForm.Title" maxlength="100" placeholder="未填時會取工作內容第一行" /></div>
                <div class="field full"><label>工作內容</label><textarea id="editWorkContent" @bind="editForm.WorkContent" class="markdown-input"></textarea></div>
            </div>
            <div class="modal-actions"><button class="button button-secondary" type="button" @onclick="CancelEditAsync">取消</button><button class="button button-primary" type="button" @onclick="() => UpdateAsync(workEntryId)">儲存變更</button></div>
        </section>
    </div>
}

@if (showManualSourceCreate)
{
    <div class="modal-backdrop" role="presentation" @onclick="CancelManualSourceCreateAsync">
        <section class="modal-dialog modal-dialog-wide" role="dialog" aria-modal="true" aria-labelledby="manual-create-title" @onclick:stopPropagation>
            <div class="modal-heading"><div><p class="eyebrow">來源活動</p><h2 id="manual-create-title">新增人工來源</h2></div><button class="modal-close" type="button" aria-label="關閉" @onclick="CancelManualSourceCreateAsync">×</button></div>
            <div class="form-grid">
                <div class="field"><label>日期</label><InputDate @bind-Value="manualSourceForm.SourceDate" /></div>
                <div class="field"><label>專案（選填）</label><select @bind="manualSourceForm.ProjectId"><option value="">未分類</option>@foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }</select></div>
                <div class="field full"><label>標題（選填）</label><input @bind="manualSourceForm.Title" maxlength="100" placeholder="未填時會取來源內容第一行" /></div>
                <div class="field full"><label>來源內容</label><textarea id="manualSourceContent" @bind="manualSourceForm.Content" class="markdown-input" placeholder="貼上會議紀錄、需求討論、Email 摘要或其他工作脈絡…"></textarea></div>
            </div>
            <div class="modal-actions"><button class="button button-secondary" type="button" @onclick="CancelManualSourceCreateAsync">取消</button><button class="button button-primary" type="button" @onclick="SaveManualSourceAsync">儲存人工來源</button></div>
        </section>
    </div>
}

@if (editingManualId is Guid manualSourceId)
{
    <div class="modal-backdrop" role="presentation" @onclick="CancelManualSourceEditAsync">
        <section class="modal-dialog modal-dialog-wide" role="dialog" aria-modal="true" aria-labelledby="manual-edit-title" @onclick:stopPropagation>
            <div class="modal-heading"><div><p class="eyebrow">來源活動</p><h2 id="manual-edit-title">編輯人工來源</h2></div><button class="modal-close" type="button" aria-label="關閉" @onclick="CancelManualSourceEditAsync">×</button></div>
            <div class="form-grid">
                <div class="field full"><label>專案</label><select @bind="editManualSourceForm.ProjectId"><option value="">未分類</option>@foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }</select></div>
                <div class="field full"><label>標題（選填）</label><input @bind="editManualSourceForm.Title" maxlength="100" placeholder="未填時會取來源內容第一行" /></div>
                <div class="field full"><label>來源內容</label><textarea id="editManualSourceContent" @bind="editManualSourceForm.Content" class="markdown-input"></textarea></div>
            </div>
            <div class="modal-actions"><button class="button button-secondary" type="button" @onclick="CancelManualSourceEditAsync">取消</button><button class="button button-primary" type="button" @onclick="() => UpdateManualSourceAsync(manualSourceId)">儲存變更</button></div>
        </section>
    </div>
}

<ConfirmDialog Open="pendingDeleteId is not null"
               Title="刪除這筆工作紀錄？"
               Message="刪除後，相關摘要會標示為需要重產；這筆工作紀錄無法復原。"
               ConfirmText="確認刪除"
               BusyText="刪除中…"
               IsBusy="isDeleting"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDelete" />

<ConfirmDialog Open="pendingManualDeleteId is not null"
               Title="刪除這筆人工來源？"
               Message="刪除後，相關摘要會標示為需要重產；這筆來源內容無法復原。"
               ConfirmText="確認刪除"
               BusyText="刪除中…"
               IsBusy="isDeleting"
               OnConfirm="ConfirmManualSourceDeleteAsync"
               OnCancel="CancelManualSourceDelete" />

@code {
    [SupplyParameterFromQuery(Name = "date")] public DateTime? RequestedDate { get; set; }
    private DateOnly selectedDate;
    private IReadOnlyList<WorkEntry> entries = [];
    private IReadOnlyList<SourceEvidence> evidence = [];
    private IReadOnlyList<Project> projects = [];
    private ReportDocument? report;
    private readonly WorkForm form = new();
    private readonly WorkForm editForm = new();
    private readonly ManualSourceForm manualSourceForm = new();
    private readonly ManualSourceForm editManualSourceForm = new();
    private Guid? editingId;
    private Guid? editingManualId;
    private Guid? pendingDeleteId;
    private Guid? pendingManualDeleteId;
    private bool isDeleting;
    private bool quickEditorInitialized;
    private bool editEditorInitialized;
    private bool manualCreateEditorInitialized;
    private bool manualEditEditorInitialized;
    private bool initializeEditEditor;
    private bool initializeManualCreateEditor;
    private bool initializeManualEditEditor;
    private bool showManualSourceCreate;
    private string editorNotice = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        selectedDate = DateOnly.FromDateTime(RequestedDate ?? DateTime.Today);
        form.WorkDate = selectedDate.ToDateTime(TimeOnly.MinValue);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        projects = await SourceConfig.GetProjectsAsync();
        entries = await WorkLogs.GetForDateAsync(selectedDate);
        var start = new DateTimeOffset(DateTime.SpecifyKind(selectedDate.ToDateTime(TimeOnly.MinValue), DateTimeKind.Local));
        evidence = await Activities.GetForRangeAsync(start, start.AddDays(1));
        report = await Reports.GetForPeriodAsync(ReportKind.Daily, selectedDate.ToString("yyyy-MM-dd"));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            quickEditorInitialized = await InitializeEditorAsync("workContent", "190px");
        }

        if (initializeEditEditor)
        {
            initializeEditEditor = false;
            editEditorInitialized = await InitializeEditorAsync("editWorkContent");
        }

        if (initializeManualCreateEditor)
        {
            initializeManualCreateEditor = false;
            manualCreateEditorInitialized = await InitializeEditorAsync("manualSourceContent");
        }

        if (initializeManualEditEditor)
        {
            initializeManualEditEditor = false;
            manualEditEditorInitialized = await InitializeEditorAsync("editManualSourceContent");
        }
    }

    private Task PreviousDay() => NavigateAsync(selectedDate.AddDays(-1));
    private Task NextDay() => NavigateAsync(selectedDate.AddDays(1));
    private Task GoToday() => NavigateAsync(DateOnly.FromDateTime(DateTime.Today));
    private Task NavigateAsync(DateOnly date) { Navigation.NavigateTo($"/?date={date:yyyy-MM-dd}"); return Task.CompletedTask; }
    private Task SelectFormDateAsync() => NavigateAsync(DateOnly.FromDateTime(form.WorkDate));

    private async Task SaveAsync()
    {
        try
        {
            form.WorkContent = await GetEditorValueAsync("workContent", quickEditorInitialized, form.WorkContent);
            await WorkLogs.AddAsync(DateOnly.FromDateTime(form.WorkDate), form.Hours ?? 0, form.WorkContent, ParseProject(form.ProjectId));
            Toasts.Success("工作紀錄已儲存。");
            form.Hours = null; form.WorkContent = string.Empty;
            await SetEditorValueAsync("workContent", quickEditorInitialized, string.Empty);
            await ReloadAsync();
        }
        catch (ArgumentException exception) { Toasts.Error(exception.Message); }
    }

    private async Task SaveManualSourceAsync()
    {
        try
        {
            manualSourceForm.Content = await GetEditorValueAsync("manualSourceContent", manualCreateEditorInitialized, manualSourceForm.Content);
            await ManualSources.AddAsync(DateOnly.FromDateTime(manualSourceForm.SourceDate), manualSourceForm.Content, ParseProject(manualSourceForm.ProjectId), manualSourceForm.Title);
            await DisposeEditorAsync("manualSourceContent", manualCreateEditorInitialized);
            manualCreateEditorInitialized = false;
            showManualSourceCreate = false;
            manualSourceForm.Title = string.Empty;
            manualSourceForm.Content = string.Empty;
            Toasts.Success("人工來源已儲存。");
            await ReloadAsync();
        }
        catch (ArgumentException exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task DeleteManualSourceAsync(Guid id)
    {
        if (isDeleting) return;
        isDeleting = true;
        try
        {
            await ManualSources.DeleteAsync(id);
            pendingManualDeleteId = null;
            Toasts.Success("人工來源已刪除。");
            await ReloadAsync();
        }
        finally
        {
            isDeleting = false;
        }
    }

    private Task OpenManualSourceCreateAsync()
    {
        manualSourceForm.SourceDate = form.WorkDate;
        showManualSourceCreate = true;
        initializeManualCreateEditor = true;
        return Task.CompletedTask;
    }

    private async Task CancelManualSourceCreateAsync()
    {
        await DisposeEditorAsync("manualSourceContent", manualCreateEditorInitialized);
        manualCreateEditorInitialized = false;
        showManualSourceCreate = false;
        manualSourceForm.Title = string.Empty;
        manualSourceForm.Content = string.Empty;
    }

    private Task BeginManualSourceEditAsync(SourceEvidence evidence)
    {
        editingManualId = evidence.Id;
        pendingManualDeleteId = null;
        editManualSourceForm.ProjectId = evidence.ProjectId?.ToString() ?? string.Empty;
        editManualSourceForm.Title = evidence.Title;
        editManualSourceForm.Content = evidence.CommitMessage;
        initializeManualEditEditor = true;
        return Task.CompletedTask;
    }

    private async Task CancelManualSourceEditAsync()
    {
        await DisposeEditorAsync("editManualSourceContent", manualEditEditorInitialized);
        manualEditEditorInitialized = false;
        editingManualId = null;
        editManualSourceForm.Title = string.Empty;
        editManualSourceForm.Content = string.Empty;
    }

    private async Task UpdateManualSourceAsync(Guid id)
    {
        try
        {
            editManualSourceForm.Content = await GetEditorValueAsync("editManualSourceContent", manualEditEditorInitialized, editManualSourceForm.Content);
            var updated = await ManualSources.UpdateAsync(
                id,
                editManualSourceForm.Content,
                ParseProject(editManualSourceForm.ProjectId),
                editManualSourceForm.Title);
            if (updated is null)
            {
                Toasts.Error("找不到要修改的人工來源，請重新整理後再試。");
                return;
            }

            await DisposeEditorAsync("editManualSourceContent", manualEditEditorInitialized);
            manualEditEditorInitialized = false;
            editingManualId = null;
            editManualSourceForm.Title = string.Empty;
            editManualSourceForm.Content = string.Empty;
            Toasts.Success("人工來源已更新。");
            await ReloadAsync();
        }
        catch (ArgumentException exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private Task BeginEditAsync(WorkEntry entry)
    {
        editingId = entry.Id;
        editForm.WorkDate = entry.WorkDate.ToDateTime(TimeOnly.MinValue);
        editForm.Hours = entry.Hours;
        editForm.Title = entry.Title;
        editForm.WorkContent = entry.WorkContent;
        editForm.ProjectId = entry.ProjectId?.ToString() ?? string.Empty;
        initializeEditEditor = true;
        return Task.CompletedTask;
    }
    private async Task CancelEditAsync()
    {
        await DisposeEditorAsync("editWorkContent", editEditorInitialized);
        editEditorInitialized = false;
        editingId = null;
    }
    private async Task UpdateAsync(Guid id)
    {
        try
        {
            editForm.WorkContent = await GetEditorValueAsync("editWorkContent", editEditorInitialized, editForm.WorkContent);
            await WorkLogs.UpdateAsync(id, DateOnly.FromDateTime(editForm.WorkDate), editForm.Hours ?? 0, editForm.WorkContent, ParseProject(editForm.ProjectId), editForm.Title);
            await DisposeEditorAsync("editWorkContent", editEditorInitialized);
            editEditorInitialized = false;
            editingId = null; Toasts.Success("工作紀錄已更新。"); await ReloadAsync();
        }
        catch (ArgumentException exception) { Toasts.Error(exception.Message); }
    }
    private async Task CopyAsync(WorkEntry entry) { form.WorkDate = entry.WorkDate.ToDateTime(TimeOnly.MinValue); form.ProjectId = entry.ProjectId?.ToString() ?? string.Empty; form.Hours = entry.Hours; form.WorkContent = entry.WorkContent; await SetEditorValueAsync("workContent", quickEditorInitialized, form.WorkContent); }
    private async Task DeleteAsync(Guid id)
    {
        if (isDeleting) return;
        isDeleting = true;
        try
        {
            await WorkLogs.DeleteAsync(id);
            pendingDeleteId = null;
            Toasts.Success("工作紀錄已刪除。");
            await ReloadAsync();
        }
        finally
        {
            isDeleting = false;
        }
    }
    private Task ConfirmDeleteAsync() => pendingDeleteId is Guid id ? DeleteAsync(id) : Task.CompletedTask;
    private Task ConfirmManualSourceDeleteAsync() => pendingManualDeleteId is Guid id ? DeleteManualSourceAsync(id) : Task.CompletedTask;
    private void CancelDelete() => pendingDeleteId = null;
    private void CancelManualSourceDelete() => pendingManualDeleteId = null;
    private static Guid? ParseProject(string value) => Guid.TryParse(value, out var id) ? id : null;
    private string ProjectName(Guid? id) => id is Guid projectId ? projects.FirstOrDefault(x => x.Id == projectId)?.Name ?? "已停用專案" : "未分類";
    private string ReportStateText() => report is null ? "未產生" : report.IsStale ? "需重產" : "最新";
    private async Task<bool> InitializeEditorAsync(string id, string? minHeight = null)
    {
        try { await JS.InvokeVoidAsync("workLensEasyMde.initialize", id, minHeight); return true; }
        catch (JSException) { editorNotice = "Markdown 編輯器無法載入，已切換為一般文字輸入。"; await InvokeAsync(StateHasChanged); return false; }
    }
    private async Task<string> GetEditorValueAsync(string id, bool initialized, string fallback)
    {
        if (!initialized) return fallback;
        try { return await JS.InvokeAsync<string>("workLensEasyMde.getValue", id); }
        catch (JSException) { editorNotice = "Markdown 編輯器連線中斷，已使用目前文字內容。"; return fallback; }
    }
    private async Task SetEditorValueAsync(string id, bool initialized, string value)
    {
        if (!initialized) return;
        try { await JS.InvokeVoidAsync("workLensEasyMde.setValue", id, value); }
        catch (JSException) { editorNotice = "Markdown 編輯器連線中斷。"; }
    }
    private async Task DisposeEditorAsync(string id, bool initialized)
    {
        if (!initialized) return;
        try { await JS.InvokeVoidAsync("workLensEasyMde.dispose", id); }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync()
    {
        await DisposeEditorAsync("workContent", quickEditorInitialized);
        await DisposeEditorAsync("editWorkContent", editEditorInitialized);
        await DisposeEditorAsync("manualSourceContent", manualCreateEditorInitialized);
        await DisposeEditorAsync("editManualSourceContent", manualEditEditorInitialized);
    }
    private sealed class WorkForm { public DateTime WorkDate { get; set; } = DateTime.Today; public double? Hours { get; set; } public string ProjectId { get; set; } = string.Empty; public string Title { get; set; } = string.Empty; public string WorkContent { get; set; } = string.Empty; }
    private sealed class ManualSourceForm { public DateTime SourceDate { get; set; } = DateTime.Today; public string ProjectId { get; set; } = string.Empty; public string Title { get; set; } = string.Empty; public string Content { get; set; } = string.Empty; }
}
