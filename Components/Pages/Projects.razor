@page "/projects"
@inject SourceConfigurationService SourceConfig

<PageTitle>專案設定｜WorkLens</PageTitle>

<div class="page-heading"><div><p class="eyebrow">Settings</p><h1>專案設定</h1><p>專案是選填分類；停用不會影響既有歷史資料。</p></div></div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@message</div>
}

<div class="panel">
    <div class="panel-heading"><div><h2>新增專案</h2><p>新專案會出現在日常紀錄的下拉選單。</p></div></div>
    <div class="button-row"><input @bind="newName" placeholder="專案名稱" /><input @bind="newColor" type="color" aria-label="專案顏色" /><button class="button button-primary" @onclick="CreateAsync">新增</button></div>
</div>

<div class="panel">
    <div class="panel-heading"><div><h2>所有專案</h2><p>停用的專案仍可在歷史篩選中查看。</p></div></div>
    @if (projects.Count == 0)
    {
        <div class="empty-state"><p>還沒有專案；日常紀錄仍可直接歸為未分類。</p></div>
    }
    else
    {
        <div class="project-list">
            @foreach (var project in projects)
            {
                <div class="source-card">
                    @if (editingId == project.Id)
                    {
                        <div class="button-row"><input @bind="editName" aria-label="專案名稱" /><input @bind="editColor" type="color" aria-label="專案顏色" /><button class="button button-primary button-small" @onclick="() => SaveAsync(project.Id)">儲存</button><button class="button button-secondary button-small" @onclick="CancelEdit">取消</button></div>
                    }
                    else
                    {
                        <div><h3><span class="status-dot" style="display:inline-block;background:@project.Color;box-shadow:none;margin-right:8px"></span>@project.Name</h3><p class="source-meta">@(project.IsArchived ? "已停用：不會出現在日常選單，既有歷史仍保留。" : "使用中") · @(project.IncludeInAi ? "允許 AI 使用" : "不提供給 AI")</p></div>
                        <div class="source-actions"><button class="button button-secondary button-small" @onclick="() => BeginEdit(project)">編輯</button><button class="button button-secondary button-small" @onclick="() => ToggleAiAsync(project)">@(project.IncludeInAi ? "停止提供給 AI" : "允許 AI 使用")</button><button class="button button-secondary button-small" @onclick="() => ToggleArchiveAsync(project)">@(project.IsArchived ? "重新啟用" : "停用")</button></div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<Project> projects = [];
    private string newName = string.Empty;
    private string newColor = "#6d7cff";
    private Guid? editingId;
    private string editName = string.Empty;
    private string editColor = "#6d7cff";
    private string message = string.Empty;
    private bool isError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync() => projects = await SourceConfig.GetProjectsAsync(includeArchived: true);
    private async Task CreateAsync()
    {
        var project = await SourceConfig.CreateProjectAsync(newName, newColor);
        if (project is null) { message = "請輸入未重複的專案名稱。"; isError = true; return; }
        newName = string.Empty; message = "專案已新增。"; isError = false; await ReloadAsync();
    }
    private void BeginEdit(Project project) { editingId = project.Id; editName = project.Name; editColor = project.Color; }
    private void CancelEdit() => editingId = null;
    private async Task SaveAsync(Guid id)
    {
        if (await SourceConfig.UpdateProjectAsync(id, editName, editColor) is null) { message = "請輸入未重複的專案名稱。"; isError = true; return; }
        editingId = null; message = "專案已更新；相關報告已標示為需要重產。"; isError = false; await ReloadAsync();
    }
    private async Task ToggleAiAsync(Project project) { await SourceConfig.SetProjectAiAsync(project.Id, !project.IncludeInAi); message = project.IncludeInAi ? "專案已停止提供給 AI。" : "專案已允許提供給 AI。"; isError = false; await ReloadAsync(); }
    private async Task ToggleArchiveAsync(Project project) { await SourceConfig.SetProjectArchivedAsync(project.Id, !project.IsArchived); message = project.IsArchived ? "專案已重新啟用。" : "專案已停用，既有歷史不受影響。"; isError = false; await ReloadAsync(); }
}
