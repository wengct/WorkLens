@page "/schedules"
@using System.Text.Json
@inject ScheduleService ScheduleManager
@inject PromptTemplateService PromptTemplates
@inject RuntimeSettingsService RuntimeSettings
@inject FolderPickerService FolderPicker
@inject ToastService Toasts

<PageTitle>排程設定｜WorkLens</PageTitle>

<div class="page-heading"><div><p class="eyebrow">Settings</p><h1>排程設定</h1><p>所有時間均使用主機本機時區：@TimeZoneInfo.Local.DisplayName</p></div></div>

<section class="panel backup-settings-panel">
    <div class="panel-heading"><div><h2>備份位置</h2><p>修改後會先驗證寫入權限，再立即套用；既有備份不會搬移。</p></div></div>
    <div class="field">
        <label for="backup-path">備份資料夾</label>
        <div class="backup-path-row"><input id="backup-path" @bind="backupPath" /><button type="button" class="button button-secondary" @onclick="PickBackupPathAsync" disabled="@IsBusy">@(selectingBackupPath ? "選擇中…" : "選擇資料夾…")</button><button class="button button-primary" @onclick="SaveBackupPathAsync" disabled="@IsBusy">驗證並套用</button></div>
        <span class="hint">目前生效：@RuntimeSettings.GetBackupPath()</span>
    </div>
</section>

<div class="schedule-grid">
    @foreach (var overview in overviews)
    {
        var schedule = overview.Definition;
        <section class="panel schedule-card">
            <div class="panel-heading">
                <div><p class="eyebrow">@KindCategory(schedule.Kind)</p><h2>@KindName(schedule.Kind)</h2><p>@ExecutionSummary(overview.LastExecution)</p></div>
                <div class="schedule-card-status"><span class="badge @StatusClass(overview.LastExecution)">@StatusText(overview.LastExecution)</span><label class="schedule-enabled"><input type="checkbox" @bind="schedule.Enabled" /> 啟用</label></div>
            </div>
            <div class="schedule-settings-row">
                <div class="field schedule-days"><label>執行日</label><div class="weekday-picker">
                    @foreach (var day in Days)
                    {
                        <label><input type="checkbox" checked="@SchedulePlanner.IncludesDay(schedule.DaysOfWeekMask, day.Value)" @onchange="args => SetDay(schedule, day.Value, args)" /> @day.Label</label>
                    }
                </div></div>
                <div class="field schedule-time"><label>執行時間</label><input type="time" value="@TimeValue(schedule)" @onchange="args => SetTime(schedule, args)" /></div>
                @if (IsReport(schedule.Kind))
                {
                    <div class="field schedule-prompt"><label>Prompt</label><select value="@PromptValue(schedule)" @onchange="args => SetPrompt(schedule, args)"><option value="">跟隨系統預設</option>@foreach (var prompt in prompts.Where(x => !x.IsArchived || x.Id == schedule.PromptTemplateId)) { <option value="@prompt.Id">@prompt.Name@(prompt.IsArchived ? "（已封存）" : string.Empty)</option> }</select></div>
                }
                <div class="schedule-actions"><button class="button button-secondary" @onclick="() => SaveScheduleAsync(schedule)" disabled="@IsBusy">儲存設定</button><button class="button button-primary" @onclick="() => RunNowAsync(schedule.Id)" disabled="@IsBusy">立即執行</button></div>
            </div>
            <div class="schedule-card-meta"><span class="hint">@ScheduleDaysHint(schedule)</span><span class="hint schedule-next-run">下次執行：@(overview.NextRun?.ToString("yyyy/MM/dd HH:mm") ?? "未排定")</span></div>
            @if (!string.IsNullOrWhiteSpace(overview.LastExecution?.Error)) { <div class="alert alert-warning schedule-error">@overview.LastExecution.Error</div> }
        </section>
    }
</div>

@code {
    private IReadOnlyList<ScheduleOverview> overviews = [];
    private IReadOnlyList<PromptTemplate> prompts = [];
    private string backupPath = string.Empty;
    private Guid? busySchedule;
    private bool savingBackupPath;
    private bool selectingBackupPath;
    private bool IsBusy => busySchedule is not null || savingBackupPath || selectingBackupPath;
    private static readonly (DayOfWeek Value, string Label)[] Days =
    [
        (DayOfWeek.Monday, "一"), (DayOfWeek.Tuesday, "二"), (DayOfWeek.Wednesday, "三"),
        (DayOfWeek.Thursday, "四"), (DayOfWeek.Friday, "五"), (DayOfWeek.Saturday, "六"), (DayOfWeek.Sunday, "日")
    ];

    protected override async Task OnInitializedAsync()
    {
        backupPath = RuntimeSettings.GetBackupPath();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        prompts = await PromptTemplates.GetAllAsync();
        overviews = await ScheduleManager.GetAsync();
    }

    private async Task SaveBackupPathAsync()
    {
        savingBackupPath = true;
        try
        {
            backupPath = await RuntimeSettings.SaveBackupPathAsync(backupPath);
            Toasts.Success("備份路徑已驗證並立即套用。");
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException or NotSupportedException)
        {
            Toasts.Error($"備份路徑無法使用：{exception.Message}");
        }
        finally { savingBackupPath = false; }
    }

    private async Task PickBackupPathAsync()
    {
        selectingBackupPath = true;
        try
        {
            var result = await FolderPicker.PickAsync(backupPath);
            if (result.Selected) backupPath = result.Path!;
            else if (!string.IsNullOrWhiteSpace(result.Error)) Toasts.Error(result.Error);
        }
        finally { selectingBackupPath = false; }
    }

    private async Task SaveScheduleAsync(ScheduleDefinition schedule)
    {
        busySchedule = schedule.Id;
        try
        {
            await ScheduleManager.SaveAsync(schedule);
            Toasts.Success($"{KindName(schedule.Kind)}排程已儲存。");
            await ReloadAsync();
        }
        catch (ArgumentException exception) { Toasts.Error(exception.Message); }
        finally { busySchedule = null; }
    }

    private async Task RunNowAsync(Guid id)
    {
        busySchedule = id;
        try
        {
            var result = await ScheduleManager.RunNowAsync(id);
            if (result is null) Toasts.Info("此排程正在執行，未重複啟動。");
            else if (result.Status == "Succeeded") Toasts.Success("排程已執行完成。");
            else Toasts.Error(result.Error ?? "排程執行失敗。");
            await ReloadAsync();
        }
        finally { busySchedule = null; }
    }

    private static void SetDay(ScheduleDefinition schedule, DayOfWeek day, ChangeEventArgs args)
    {
        var bit = 1 << (int)day;
        if (args.Value is bool enabled && enabled) schedule.DaysOfWeekMask |= bit;
        else schedule.DaysOfWeekMask &= ~bit;
    }

    private static void SetTime(ScheduleDefinition schedule, ChangeEventArgs args)
    {
        if (TimeOnly.TryParse(args.Value?.ToString(), out var time)) { schedule.Hour = time.Hour; schedule.Minute = time.Minute; }
    }

    private static void SetPrompt(ScheduleDefinition schedule, ChangeEventArgs args) =>
        schedule.PromptTemplateId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;

    private static string PromptValue(ScheduleDefinition schedule) => schedule.PromptTemplateId?.ToString() ?? string.Empty;
    private static string TimeValue(ScheduleDefinition schedule) => $"{schedule.Hour:00}:{schedule.Minute:00}";
    private static bool IsReport(ScheduleKind kind) => kind is ScheduleKind.DailyReport or ScheduleKind.WeeklyReport;
    private static string KindCategory(ScheduleKind kind) => IsReport(kind) ? "REPORT" : "BACKUP";
    private static string KindName(ScheduleKind kind) => kind switch { ScheduleKind.DailyReport => "日報", ScheduleKind.WeeklyReport => "週報", ScheduleKind.DailyBackup => "自動備份", _ => "舊版每週備份" };
    private static string ScheduleDaysHint(ScheduleDefinition schedule)
    {
        if (schedule.Kind == ScheduleKind.DailyBackup)
        {
            return schedule.DaysOfWeekMask == ScheduleDefaults.EveryDayMask
                ? "已選擇每天備份；取消部分星期即可改為每週指定日備份。"
                : "備份會在勾選的星期執行；勾選全部七天即為每天備份。";
        }

        return schedule.Kind == ScheduleKind.DailyReport
            ? "每個勾選日各自產生當日 00:00 至 24:00 的報告。"
            : "每週只產生一份週一至週日的報告；若勾選多日，以該週最先觸發的執行日為準。";
    }
    private static string StatusText(ScheduleExecution? execution) => execution?.Status switch { "Succeeded" => "成功", "Failed" => "失敗", "Running" => "執行中", "Cancelled" => "已取消", "Interrupted" => "已中斷", _ => "尚未執行" };
    private static string StatusClass(ScheduleExecution? execution) => execution?.Status switch { "Succeeded" => "badge-ready", "Failed" or "Interrupted" => "badge-error", "Running" => "badge-running", _ => "badge-disabled" };
    private static string ExecutionSummary(ScheduleExecution? execution)
    {
        if (execution is null) return "尚無執行紀錄";

        var summary = $"上次執行：{execution.StartedAt.LocalDateTime:yyyy/MM/dd HH:mm}｜規則式 {execution.DeterministicStatus}｜AI {execution.AiStatus}｜備份 {execution.BackupStatus}";
        if (execution.SanitizedFindingCount <= 0) return summary;

        var categories = string.Empty;
        try
        {
            var notices = JsonSerializer.Deserialize<List<AiRedactionNotice>>(execution.SanitizedCategoriesJson) ?? [];
            categories = string.Join("、", notices
                .GroupBy(x => x.Category)
                .Select(group => $"{SensitiveCategoryText(group.Key)} {group.Sum(x => x.Count)}處"));
        }
        catch (JsonException)
        {
            // The count remains useful even if an old record has no category details.
        }

        return string.IsNullOrWhiteSpace(categories)
            ? $"{summary}｜已遮蔽機敏資訊 {execution.SanitizedFindingCount}處"
            : $"{summary}｜已遮蔽機敏資訊：{categories}";
    }

    private static string SensitiveCategoryText(AiSensitiveDataCategory category) => category switch
    {
        AiSensitiveDataCategory.Credential => "機敏憑證",
        AiSensitiveDataCategory.PersonalData => "個人資料",
        _ => "自訂敏感詞"
    };
}
