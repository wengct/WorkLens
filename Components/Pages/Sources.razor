    private sealed class AzureDevOpsScopeForm
    {
        public AzureDevOpsScopeForm()
        {
        }

        public AzureDevOpsScopeForm(AzureDevOpsPullRequestScope scope)
        {
            ProjectId = scope.ProjectId;
            ProjectName = scope.ProjectName;
            RepositoryId = scope.RepositoryId;
            RepositoryName = scope.RepositoryName;
            TargetBranch = SourceSettingsSerializer.NormalizeAzureDevOpsBranch(scope.TargetBranch);
            WorkLensProjectId = scope.WorkLensProjectId;
        }

        public string ProjectId { get; set; } = string.Empty;
        public string ProjectName { get; set; } = string.Empty;
        public string RepositoryId { get; set; } = string.Empty;
        public string RepositoryName { get; set; } = string.Empty;
        public string TargetBranch { get; set; } = string.Empty;
        public Guid? WorkLensProjectId { get; set; }
        public List<AzureDevOpsOption> Repositories { get; set; } = [];
        public List<AzureDevOpsOption> Branches { get; set; } = [];

        public AzureDevOpsPullRequestScope ToSettings() => new()
        {
            ProjectId = ProjectId,
            ProjectName = ProjectName,
            RepositoryId = RepositoryId,
            RepositoryName = RepositoryName,
            TargetBranch = SourceSettingsSerializer.NormalizeAzureDevOpsBranch(TargetBranch),
            WorkLensProjectId = WorkLensProjectId
        };

        public void ClearSelections()
        {
            ProjectId = string.Empty;
            ProjectName = string.Empty;
            RepositoryId = string.Empty;
            RepositoryName = string.Empty;
            TargetBranch = string.Empty;
            Repositories.Clear();
            Branches.Clear();
        }
    }

