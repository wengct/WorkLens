    private async Task SaveSourceAsync()
    {
        var newType = SelectedSourceType;
        if (IsGitType(newType))
        {
            CommitAuthorEmailInput();
            CommitRepositoryPathInput();
        }
        var paths = repositoryPaths
            .Where(path => path.Length > 0)
            .Where(x => x.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var configuredAuthorEmails = SourceSettingsSerializer.NormalizeAuthorEmails(authorEmails).ToList();
        if (IsGitType(newType) && paths.Count == 0)
        {
            SetError("Git 來源至少需要一個 repository 路徑。");
            return;
        }

        if (IsGitType(newType) && configuredAuthorEmails.Count == 0)
        {
            SetError("Git 來源至少需要設定一組自己的作者 email。");
            return;
        }

        if (IsGitType(newType) && configuredAuthorEmails.Any(email => !SourceSettingsSerializer.IsValidAuthorEmail(email)))
        {
            SetError("請修正作者 email 格式；每組 email 都必須包含單一 @ 且不可含空白。");
            return;
        }

        if ((newType is ActivitySourceType.WslCodex or ActivitySourceType.WslClaudeCode or ActivitySourceType.WslCopilot or ActivitySourceType.WslVsCodeCopilot) && string.IsNullOrWhiteSpace(newDistro))
        {
            SetError($"WSL {SourceKindText(newKind)} 來源必須指定 Linux 環境名稱，例如 Ubuntu。");
            return;
        }

        if (newType == ActivitySourceType.WindowsVisualStudioCopilot && ParsePathList(newVisualStudioPaths).Count == 0)
        {
            SetError("Visual Studio Copilot Chat 來源至少需要一個方案目錄。");
            return;
        }

        if (newType == ActivitySourceType.AzureDevOpsPullRequest)
        {
            var organization = SourceSettingsSerializer.NormalizeAzureDevOpsOrganizationUrl(newAdoOrganization);
            if (!AzureDevOpsCliService.IsSupportedOrganizationUrl(organization))
            {
                SetError("請輸入有效的 Azure DevOps Services Organization HTTPS URL。");
                return;
            }

            if (adoScopes.Count == 0 || adoScopes.Any(scope =>
                    string.IsNullOrWhiteSpace(scope.ProjectId) ||
                    string.IsNullOrWhiteSpace(scope.RepositoryId) ||
                    string.IsNullOrWhiteSpace(scope.ToSettings().TargetBranch)))
            {
                SetError("Azure DevOps PR 來源至少需要一組完整的 Project、Repo 與 target branch。");
                return;
            }

            var scopeKeys = adoScopes
                .Select(scope => SourceSettingsSerializer.AzureDevOpsScopeKey(scope.ToSettings()))
                .ToList();
            if (scopeKeys.Count != scopeKeys.Distinct(StringComparer.OrdinalIgnoreCase).Count())
            {
                SetError("Azure DevOps PR 來源不可重複設定相同的 Project、Repo 與 target branch。");
                return;
            }
        }

        var existing = editingSourceId is Guid id
            ? sources.FirstOrDefault(source => source.Id == id)
            : null;
        if (editingSourceId is not null && existing is null)
        {
            SetError("找不到要編輯的資料來源，請重新整理後再試。");
            return;
        }

        Guid? projectId = Guid.TryParse(projectSelection, out var parsedProject) ? parsedProject : null;
        var source = new ActivitySource
        {
            Id = existing?.Id ?? Guid.NewGuid(),
            DisplayName = string.IsNullOrWhiteSpace(newName) ? SuggestedSourceName : newName,
            SourceType = newType,
            Enabled = newEnabled,
            IsArchived = existing?.IsArchived ?? false,
            ProjectId = projectId,
            CollectionIntervalMinutes = newInterval,
            InitialImportDays = newImportDays,
            IncludeInAi = newIncludeInAi,
            CreatedAt = existing?.CreatedAt ?? DateTimeOffset.UtcNow,
            LastSuccessAt = existing?.LastSuccessAt,
            LastError = existing?.LastError,
            CheckpointJson = existing?.CheckpointJson ?? "{}",
            SettingsJson = IsGitType(newType)
                ? SourceSettingsSerializer.Serialize(new GitSourceSettings
                {
                    RepositoryPaths = paths,
                    AuthorEmails = configuredAuthorEmails,
                    Distro = newType == ActivitySourceType.WslGit ? newDistro.Trim() : null
                })
                : IsAdoType(newType)
                    ? SourceSettingsSerializer.Serialize(new AzureDevOpsSourceSettings
                    {
                        OrganizationUrl = SourceSettingsSerializer.NormalizeAzureDevOpsOrganizationUrl(newAdoOrganization),
                        Scopes = adoScopes.Select(scope => scope.ToSettings()).ToList()
                    })
                     : IsCodexType(newType)
                         ? SourceSettingsSerializer.Serialize(new CodexSourceSettings
                        {
                            CodexHome = string.IsNullOrWhiteSpace(newCodexHome) ? null : newCodexHome.Trim(),
                            Distro = newType == ActivitySourceType.WslCodex ? newDistro.Trim() : null
                         })
                         : IsClaudeCodeType(newType)
                             ? SourceSettingsSerializer.Serialize(new ClaudeCodeSourceSettings
                             {
                                 ClaudeCodeHome = string.IsNullOrWhiteSpace(newClaudeCodeHome) ? null : newClaudeCodeHome.Trim(),
                                 Distro = newType == ActivitySourceType.WslClaudeCode ? newDistro.Trim() : null
                             })
                              : IsCopilotType(newType)
                                 ? SourceSettingsSerializer.Serialize(new CopilotSourceSettings
                                 {
                                     CopilotHome = string.IsNullOrWhiteSpace(newCopilotHome) ? null : newCopilotHome.Trim(),
                                     Distro = newType == ActivitySourceType.WslCopilot ? newDistro.Trim() : null
                                 })
                                 : IsVsCodeCopilotType(newType)
                                     ? SourceSettingsSerializer.Serialize(new VsCodeCopilotSourceSettings
                                     {
                                         WorkspaceStoragePaths = ParsePathList(newVsCodePaths),
                                         Distro = newType == ActivitySourceType.WslVsCodeCopilot ? newDistro.Trim() : null
                                     })
                                     : SourceSettingsSerializer.Serialize(new VisualStudioCopilotSourceSettings
                                     {
                                         SolutionPaths = ParsePathList(newVisualStudioPaths)
                                     })
        };
        await SourceConfig.SaveAsync(source);
        Toasts.Success(existing is null
            ? "來源已新增。請按「驗證」確認環境與資料路徑。"
            : "來源設定已更新。請重新按「驗證」確認環境與資料路徑。");
        ResetForm();
        await ReloadAsync();
        activeWorkspace = SourceWorkspace.Overview;
    }

    private async Task BeginEditAsync(ActivitySource source)
    {
        editingSourceId = source.Id;
        newName = source.DisplayName;
        (newKind, newLocation) = ToSourceSelection(source.SourceType);
        if (IsGitType(source.SourceType))
        {
            var settings = SourceSettingsSerializer.DeserializeGit(source.SettingsJson);
            newDistro = settings.Distro ?? string.Empty;
            newCodexHome = string.Empty;
            newClaudeCodeHome = string.Empty;
            newCopilotHome = string.Empty;
            newVsCodePaths = string.Empty;
            newVisualStudioPaths = string.Empty;
            repositoryPaths = settings.RepositoryPaths.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            authorEmails = SourceSettingsSerializer.NormalizeAuthorEmails(settings.AuthorEmails).ToList();
        }
        else if (IsAdoType(source.SourceType))
        {
            var settings = SourceSettingsSerializer.DeserializeAzureDevOps(source.SettingsJson);
            newAdoOrganization = settings.OrganizationUrl;
            newDistro = string.Empty;
            newCodexHome = string.Empty;
            newClaudeCodeHome = string.Empty;
            newCopilotHome = string.Empty;
            newVsCodePaths = string.Empty;
            newVisualStudioPaths = string.Empty;
            repositoryPaths.Clear();
            authorEmails.Clear();
            adoScopes.Clear();
            foreach (var scope in settings.Scopes)
            {
                adoScopes.Add(new AzureDevOpsScopeForm(scope));
            }

            if (adoScopes.Count == 0)
            {
                adoScopes.Add(new AzureDevOpsScopeForm());
            }
        }
        else if (IsClaudeCodeType(source.SourceType))
        {
            var settings = SourceSettingsSerializer.DeserializeClaudeCode(source.SettingsJson);
            newDistro = settings.Distro ?? string.Empty;
            newClaudeCodeHome = settings.ClaudeCodeHome ?? string.Empty;
            newCodexHome = string.Empty;
            newCopilotHome = string.Empty;
            newVsCodePaths = string.Empty;
            newVisualStudioPaths = string.Empty;
            repositoryPaths.Clear();
            authorEmails.Clear();
        }
        else if (IsCopilotType(source.SourceType))
        {
            var settings = SourceSettingsSerializer.DeserializeCopilot(source.SettingsJson);
            newDistro = settings.Distro ?? string.Empty;
            newCopilotHome = settings.CopilotHome ?? string.Empty;
            newCodexHome = string.Empty;
            newClaudeCodeHome = string.Empty;
            newVsCodePaths = string.Empty;
            newVisualStudioPaths = string.Empty;
            repositoryPaths.Clear();
            authorEmails.Clear();
        }
        else if (IsVsCodeCopilotType(source.SourceType))
        {
            var settings = SourceSettingsSerializer.DeserializeVsCodeCopilot(source.SettingsJson);
            newDistro = settings.Distro ?? string.Empty;
            newVsCodePaths = string.Join(";", settings.WorkspaceStoragePaths);
            newCodexHome = string.Empty;
            newClaudeCodeHome = string.Empty;
            newCopilotHome = string.Empty;
            newVisualStudioPaths = string.Empty;
            repositoryPaths.Clear();
            authorEmails.Clear();
        }
        else if (source.SourceType == ActivitySourceType.WindowsVisualStudioCopilot)
        {
            var settings = SourceSettingsSerializer.DeserializeVisualStudioCopilot(source.SettingsJson);
            newVisualStudioPaths = string.Join(";", settings.SolutionPaths);
            newDistro = string.Empty;
            newCodexHome = string.Empty;
            newClaudeCodeHome = string.Empty;
            newCopilotHome = string.Empty;
            newVsCodePaths = string.Empty;
            repositoryPaths.Clear();
            authorEmails.Clear();
        }
        else
        {
            var settings = SourceSettingsSerializer.DeserializeCodex(source.SettingsJson);
            newDistro = settings.Distro ?? string.Empty;
            newCodexHome = settings.CodexHome ?? string.Empty;
            newClaudeCodeHome = string.Empty;
            newCopilotHome = string.Empty;
            newVsCodePaths = string.Empty;
            newVisualStudioPaths = string.Empty;
            repositoryPaths.Clear();
            authorEmails.Clear();
        }
        repositoryPathInput = string.Empty;
        authorEmailInput = string.Empty;
        projectSelection = source.ProjectId?.ToString() ?? string.Empty;
        newInterval = source.CollectionIntervalMinutes;
        newImportDays = source.InitialImportDays;
        newEnabled = source.Enabled;
        newIncludeInAi = source.IncludeInAi;
        activeWorkspace = SourceWorkspace.Setup;
        Toasts.Info($"正在編輯「{source.DisplayName}」。儲存後不會清除既有 checkpoint 或歷程。");
        if (IsAdoType(source.SourceType))
        {
            await DiagnoseAzureDevOpsAsync();
        }
    }

