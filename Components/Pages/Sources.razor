@page "/sources"
@inject SourceConfigurationService SourceConfig
@inject SourceOrchestrator Orchestrator
@inject AzureDevOpsCliService AzureDevOpsCli
@inject ToastService Toasts
@implements IAsyncDisposable

<PageTitle>資料來源｜WorkLens</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Configurable collectors</p>
        <h1>資料來源</h1>
        <p>沒有設定就不會自動蒐集。每個來源可以獨立啟用、停用、排程與決定是否提供給 AI。</p>
    </div>
</div>

<nav class="source-workspace-tabs" aria-label="資料來源工作區">
    <button type="button"
            class="source-workspace-tab @(activeWorkspace == SourceWorkspace.Overview ? "active" : null)"
            aria-current="@(activeWorkspace == SourceWorkspace.Overview ? "page" : null)"
            @onclick="() => SelectWorkspace(SourceWorkspace.Overview)">
        <span>來源總覽</span>
        <span class="source-workspace-count">@sources.Count</span>
    </button>
    <button type="button"
            class="source-workspace-tab @(activeWorkspace == SourceWorkspace.Setup ? "active" : null)"
            aria-current="@(activeWorkspace == SourceWorkspace.Setup ? "page" : null)"
            @onclick="() => SelectWorkspace(SourceWorkspace.Setup)">
        @(editingSourceId is null ? "新增來源" : "編輯來源")
    </button>
    <button type="button"
            class="source-workspace-tab @(activeWorkspace == SourceWorkspace.Backfill ? "active" : null)"
            aria-current="@(activeWorkspace == SourceWorkspace.Backfill ? "page" : null)"
            @onclick="() => SelectWorkspace(SourceWorkspace.Backfill)">
        資料回補
    </button>
</nav>

@if (activeWorkspace == SourceWorkspace.Setup)
{
<div class="panel">
    <div class="panel-heading">
        <div>
            <h2>@(editingSourceId is null ? "新增來源" : "編輯來源")</h2>
            <p>先選擇要收集的內容；一般情況使用「此電腦」，只有資料位於 WSL 時才需切換執行位置。</p>
        </div>
    </div>
    <div class="form-grid">
        <div class="field">
            <label for="sourceKind">要收集什麼？</label>
            <select id="sourceKind" @bind="newKind" @bind:after="SourceKindChangedAsync">
                <option value="Git">Git repository</option>
                <option value="Codex">Codex 工作紀錄</option>
                <option value="ClaudeCode">Claude Code 工作紀錄</option>
                <option value="Copilot">GitHub Copilot CLI／App 工作紀錄</option>
                <option value="VsCodeCopilot">VS Code Copilot Chat 工作紀錄</option>
                <option value="VisualStudioCopilot">Visual Studio Copilot Chat（Visual Studio 2026）</option>
                <option value="AzureDevOps">Azure DevOps PR</option>
            </select>
        </div>
        @if (SupportsWsl && newKind != SourceKind.AzureDevOps)
        {
            <div class="field">
                <label for="sourceLocation">資料位於哪裡？</label>
                <select id="sourceLocation" @bind="newLocation">
                    <option value="Native">此電腦（Windows）</option>
                    <option value="Wsl">WSL Linux</option>
                </select>
                <span class="hint">大多數情況請保留「此電腦」。</span>
            </div>
        }
        <div class="field">
            <label for="sourceName">來源名稱（選填）</label>
            <input id="sourceName" @bind="newName" placeholder="留空將使用「@SuggestedSourceName」" />
            <span class="hint">可用來區分多組 repository 或不同的 Codex／Claude Code 資料目錄。</span>
        </div>
        @if (newKind != SourceKind.AzureDevOps && newLocation == SourceLocation.Wsl)
        {
            <div class="field">
                <label for="distro">WSL Linux 環境</label>
                <input id="distro" @bind="newDistro" placeholder="例如：Ubuntu" />
                <span class="hint">只有儲存後按「驗證」時才會偵測 WSL。</span>
            </div>
        }
        @if (newKind != SourceKind.AzureDevOps)
        {
        <div class="field">
            <label for="project">Project 映射</label>
            <select id="project" @bind="projectSelection">
                <option value="">待分類</option>
                @foreach (var project in projects)
                {
                    <option value="@project.Id">@project.Name</option>
            }
        </select>
        </div>
        }
        @if (newKind == SourceKind.Git)
        {
        <div class="field full">
            <label for="repositories">Repository 路徑</label>
            <div class="pill-editor">
                @foreach (var path in repositoryPaths)
                {
                    <span class="email-pill">
                        <span title="@path">@path</span>
                        <button type="button" class="pill-remove" title="移除 @path" aria-label="移除 @path" @onclick="() => RemoveRepositoryPath(path)">×</button>
                    </span>
                }
                <input id="repositories"
                       value="@repositoryPathInput"
                       @oninput="HandleRepositoryPathInput"
                       @onkeydown="HandleRepositoryPathKeyDown"
                       @onblur="CommitRepositoryPathInput"
                       placeholder="輸入路徑後按 Enter" />
            </div>
            <span class="hint">一個 repository 一個 pill；可貼上多行路徑，或輸入後按 Enter 加入。</span>
            <span class="hint">路徑與來源設定儲存在本機資料庫，不會寫入 WorkLens repository。</span>
        </div>
        <div class="field full">
            <label for="authorEmailInput">自己的 Git 作者 email（必填，可多組）</label>
            <div class="pill-editor">
                @foreach (var email in authorEmails)
                {
                    <span class="email-pill">
                        <span title="@email">@email</span>
                        <button type="button"
                                class="pill-remove"
                                title="移除 @email"
                                aria-label="移除 @email"
                                @onclick="() => RemoveAuthorEmail(email)">×</button>
                    </span>
                }
                <input id="authorEmailInput"
                       value="@authorEmailInput"
                       @oninput="HandleAuthorEmailInput"
                       @onkeydown="HandleAuthorEmailKeyDown"
                       @onblur="CommitAuthorEmailInput"
                       placeholder="輸入 email 後按 Enter" />
            </div>
            <span class="hint">只會納入作者 email 完全符合這些設定的 commit；按 Enter、逗號或分號加入一組 pill。</span>
        </div>
        }
        @if (newKind is SourceKind.Codex or SourceKind.ClaudeCode or SourceKind.Copilot or SourceKind.VsCodeCopilot or SourceKind.VisualStudioCopilot)
        {
            <div class="field full">
                <label for="aiCodeHome">@SourcePathLabel(newKind)</label>
                @if (newKind == SourceKind.Codex)
                {
                    <input id="aiCodeHome" @bind="newCodexHome" placeholder="留空即自動偵測 CODEX_HOME 或 ~/.codex" />
                }
                else if (newKind == SourceKind.ClaudeCode)
                {
                    <input id="aiCodeHome" @bind="newClaudeCodeHome" placeholder="留空即自動偵測 CLAUDE_CONFIG_DIR 或 ~/.claude" />
                }
                else if (newKind == SourceKind.Copilot)
                {
                    <input id="aiCodeHome" @bind="newCopilotHome" placeholder="留空即自動偵測 COPILOT_HOME 或 ~/.copilot" />
                }
                else if (newKind == SourceKind.VisualStudioCopilot)
                {
                    <input id="aiCodeHome" @bind="newVisualStudioPaths" placeholder="填入方案目錄；多個路徑請以分號分隔" />
                }
                else
                {
                    <input id="aiCodeHome" @bind="newVsCodePaths" placeholder="留空即自動偵測 Stable／Insiders workspaceStorage" />
                }
                @if (newKind == SourceKind.VsCodeCopilot)
                {
                    <span class="hint">可填一或多個 workspaceStorage 根目錄，以分號分隔；每個 workspace 下會掃描 chatSessions。</span>
                }
                else if (newKind == SourceKind.VisualStudioCopilot)
                {
                    <span class="hint">WorkLens 會從方案目錄尋找 .vs/copilot-chat；支援 Visual Studio 2026 Chat 與 Agent（Preview）。</span>
                }
                else
                {
                    <span class="hint">Windows 與 macOS 請填本機路徑；WSL 請填該 Linux 環境內的路徑。</span>
                }
            </div>
        }
        @if (newKind == SourceKind.AzureDevOps)
        {
            <div class="field full ado-source-setup">
                <div class="panel-heading compact-heading">
                    <div>
                        <h3>Azure DevOps CLI 連線</h3>
                        <p>WorkLens 只會使用目前主機的原生 Azure CLI；不會從 Windows 呼叫 WSL，也不會替你安裝、登入或變更 CLI 設定。</p>
                    </div>
                    <button type="button" class="button button-secondary button-small" @onclick="DiagnoseAzureDevOpsAsync" disabled="@isLoadingAdoOptions">@(isLoadingAdoOptions ? "檢測中…" : "重新檢測")</button>
                </div>
                <div class="field">
                    <label for="adoOrganization">Azure DevOps Organization URL</label>
                    <input id="adoOrganization" value="@newAdoOrganization" @oninput="HandleAdoOrganizationInput" @onblur="DiagnoseAzureDevOpsAsync" placeholder="https://dev.azure.com/contoso" />
                    <span class="hint">只支援 Azure DevOps Services（不支援 Azure DevOps Server）；支援 https://dev.azure.com/&lt;org&gt; 與 https://&lt;org&gt;.visualstudio.com，不同 Organization 請建立不同來源。</span>
                </div>
                @if (adoDiagnostics is not null)
                {
                    <div class="source-diagnostics" aria-live="polite">
                        <div class="source-diagnostics-title @(adoDiagnostics.IsValid ? "text-success" : "text-warning")">@adoDiagnostics.Summary</div>
                        <div class="source-diagnostics-grid">
                            <span class="badge @(adoDiagnostics.CliInstalled ? "badge-ready" : "badge-error")">Azure CLI：@(adoDiagnostics.CliInstalled ? adoDiagnostics.CliVersion ?? "已安裝" : "未安裝")</span>
                            <span class="badge @(adoDiagnostics.ExtensionInstalled ? "badge-ready" : "badge-error")">Azure DevOps extension：@(adoDiagnostics.ExtensionInstalled ? adoDiagnostics.ExtensionVersion ?? "已安裝" : "未安裝")</span>
                            <span class="badge @(adoDiagnostics.IsLoggedIn ? "badge-ready" : "badge-error")">登入：@(adoDiagnostics.IsLoggedIn ? adoDiagnostics.AccountName ?? "已登入" : "未登入")</span>
                            <span class="badge @(adoDiagnostics.IsInteractiveUser ? "badge-ready" : "badge-error")">一般使用者：@(adoDiagnostics.IsInteractiveUser ? "是" : "否")</span>
                            @if (!string.IsNullOrWhiteSpace(newAdoOrganization) && adoDiagnostics.IsValid)
                            {
                                <span class="badge @(adoProjectLoadError is null ? "badge-ready" : "badge-error")">Projects：@(adoProjectLoadError is null ? $"已載入 {adoProjects.Count} 個" : "載入失敗")</span>
                            }
                        </div>
                        @foreach (var detail in adoDiagnostics.Details)
                        {
                            <div class="source-diagnostics-detail">@detail</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(adoProjectLoadError))
                        {
                            <div class="source-diagnostics-detail text-warning">Projects 載入失敗：@adoProjectLoadError</div>
                        }
                    </div>
                }
                <div class="install-instructions">
                    <strong>安裝與登入方式</strong>
                    <span>Windows：安裝 <a href="https://learn.microsoft.com/en-us/cli/azure/install-azure-cli-windows" target="_blank" rel="noreferrer">Azure CLI</a>（或執行 <code>winget install --exact --id Microsoft.AzureCLI</code>）。</span>
                    <span>macOS：依 <a href="https://learn.microsoft.com/en-us/cli/azure/install-azure-cli-macos" target="_blank" rel="noreferrer">官方說明</a> 使用 Homebrew 安裝。</span>
                    <span>Linux：依 <a href="https://learn.microsoft.com/en-us/cli/azure/install-azure-cli-linux" target="_blank" rel="noreferrer">官方說明</a> 使用套件管理器安裝。</span>
                    <span>所有平台都要再安裝 Azure DevOps CLI extension：<code>az extension add --name azure-devops</code>。</span>
                    <span>最後執行 <code>az login</code>，完成後回到此頁按「重新檢測」。</span>
                    <span class="hint">WorkLens 會以 <code>az ad signed-in-user show</code> 取得登入者的 UPN；Entra object ID 不等同 ADO PR 的 <code>createdBy.id</code>，不會直接拿來比對。</span>
                </div>
                <div class="ado-scope-editor">
                    <div class="ado-scope-heading">
                        <strong>PR 收集組合</strong>
                        <span class="hint">只會取得目前登入者建立、且 target branch 符合的 PR。</span>
                    </div>
                    @foreach (var scope in adoScopes)
                    {
                        <div class="ado-scope-row" @key="scope">
                            <div class="field">
                                <label>ADO Project</label>
                                <select value="@scope.ProjectId" @onchange="eventArgs => ChangeAdoProjectAsync(scope, eventArgs.Value?.ToString())" disabled="@isLoadingAdoOptions">
                                    <option value="">請先選擇 Project</option>
                                    @foreach (var project in adoProjects)
                                    {
                                        <option value="@project.Id">@project.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>Repo</label>
                                <select value="@scope.RepositoryId" @onchange="eventArgs => ChangeAdoRepositoryAsync(scope, eventArgs.Value?.ToString())" disabled="@(isLoadingAdoOptions || scope.Repositories.Count == 0)">
                                    <option value="">請先選擇 Repo</option>
                                    @foreach (var repository in scope.Repositories)
                                    {
                                        <option value="@repository.Id">@repository.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>target branch</label>
                                <select value="@scope.TargetBranch" @onchange="eventArgs => ChangeAdoBranch(scope, eventArgs.Value?.ToString())" disabled="@(isLoadingAdoOptions || scope.Branches.Count == 0)">
                                    <option value="">請選擇 target branch</option>
                                    @foreach (var branch in scope.Branches)
                                    {
                                        <option value="@branch.Id">@branch.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>WorkLens Project</label>
                                <select value="@(scope.WorkLensProjectId?.ToString() ?? string.Empty)" @onchange="eventArgs => ChangeWorkLensProject(scope, eventArgs.Value?.ToString())">
                                    <option value="">待分類</option>
                                    @foreach (var project in projects)
                                    {
                                        <option value="@project.Id">@project.Name</option>
                                    }
                                </select>
                            </div>
                            <button type="button" class="button button-danger button-small ado-scope-remove" @onclick="() => RemoveAdoScope(scope)" disabled="@(adoScopes.Count == 1)">移除</button>
                        </div>
                    }
                    <button type="button" class="button button-secondary button-small" @onclick="AddAdoScope" disabled="@isLoadingAdoOptions">＋新增一組</button>
                </div>
            </div>
        }
        <details class="source-advanced full">
            <summary>進階設定</summary>
            <div class="form-grid">
                <div class="field">
                    <label for="interval">收集間隔（分鐘）</label>
                    <input id="interval" type="number" min="1" max="1440" @bind="newInterval" />
                </div>
                <div class="field">
                    <label for="importDays">首次匯入天數</label>
                    <input id="importDays" type="number" min="1" max="90" @bind="newImportDays" />
                </div>
                <label class="inline-checkbox full"><input type="checkbox" @bind="newIncludeInAi" /> 允許提供給 AI</label>
            </div>
        </details>
        <div class="form-actions">
            <label class="inline-checkbox"><input type="checkbox" @bind="newEnabled" /> 儲存後啟用</label>
            <button class="button button-primary" @onclick="SaveSourceAsync">@(editingSourceId is null ? "新增來源" : "儲存來源設定")</button>
            @if (editingSourceId is not null)
            {
                <button class="button button-secondary" @onclick="CancelEdit">取消編輯</button>
            }
        </div>
    </div>
</div>
}

@if (activeWorkspace == SourceWorkspace.Backfill)
{
<div class="panel">
    <div class="panel-heading"><div><h2>回補來源資料</h2><p>指定期間重新收集，不會改變正常排程 checkpoint。單次最多 90 天。</p></div></div>
    <div class="form-grid">
        <div class="field"><label>起始日期</label><InputDate @bind-Value="backfillStart" /></div>
        <div class="field"><label>結束日期</label><InputDate @bind-Value="backfillEnd" /></div>
        <div class="field full"><label>來源</label><select @bind="backfillSourceId"><option value="">全部可用來源</option>@foreach (var source in sources.Where(source => source.Enabled && source.HealthStatus == SourceHealthStatus.Ready)) { <option value="@source.Id">@source.DisplayName</option> }</select></div>
        <div class="form-actions">
            @if (isBackfilling)
            {
                <button class="button button-danger" @onclick="StopBackfill" disabled="@IsStoppingBackfill">@(IsStoppingBackfill ? "正在停止…" : "停止回補")</button>
            }
            else
            {
                <button class="button button-secondary" @onclick="BackfillAsync">重新收集此範圍</button>
            }
        </div>
    </div>
    @if (isBackfilling)
    {
        <div class="collection-progress" aria-live="polite">
            <div><strong>正在回補來源資料…</strong><span>完成前請保持此頁開啟。</span></div>
            <div class="collection-progress-track"><span></span></div>
        </div>
    }
</div>
}

@if (activeWorkspace == SourceWorkspace.Overview)
{
<div class="panel">
    <div class="panel-heading">
        <div>
            <h2>來源總覽</h2>
            <p>停用或封存只停止未來收集，不刪除既有工作歷程。</p>
        </div>
        <button type="button" class="button button-primary" @onclick="BeginAdd">新增來源</button>
    </div>
    @if (sources.Count == 0)
    {
        <div class="empty-state">
            <h3>目前是純人工模式</h3>
            <p>這是預設狀態。你可以稍後再新增目前平台的 Git、Codex、Claude Code、GitHub Copilot、VS Code Copilot 或 Azure DevOps PR 來源。</p>
            <button type="button" class="button button-primary" @onclick="BeginAdd">新增第一個來源</button>
        </div>
    }
    else
    {
        @foreach (var source in sources)
        {
            var sourceIsCollecting = collectingSourceIds.Contains(source.Id) || source.HealthStatus == SourceHealthStatus.Running;
            var sourceIsValidating = validatingSourceIds.Contains(source.Id);
            var sourceIsStopping = stoppingSourceIds.Contains(source.Id);
            var sourceIsBusy = sourceIsCollecting || sourceIsValidating;
            var adoSettings = IsAdoType(source.SourceType)
                ? SourceSettingsSerializer.DeserializeAzureDevOps(source.SettingsJson)
                : null;
            <div class="source-card">
                <div>
                    <div class="source-title">
                        <h3>@source.DisplayName</h3>
                        <span class="badge @StatusClass(sourceIsBusy ? SourceHealthStatus.Running : source.HealthStatus)">@(sourceIsValidating ? "驗證中" : sourceIsStopping ? "停止中" : sourceIsCollecting ? "收集中" : StatusText(source.HealthStatus))</span>
                        @if (source.IncludeInAi)
                        {
                            <span class="badge badge-provisional">AI</span>
                        }
                    </div>
                    <div class="source-meta">
                        類型：@SourceTypeText(source.SourceType) · 間隔：@source.CollectionIntervalMinutes 分鐘
                        @if (source.LastSuccessAt is not null)
                        {
                            <span> · 最近成功：@source.LastSuccessAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(source.LastError))
                        {
                            <span class="text-danger">@source.LastError</span>
                        }
                        @if (adoSettings is not null)
                        {
                            <span> · @adoSettings.Scopes.Count 組 · @adoSettings.OrganizationUrl</span>
                        }
                    </div>
                    @if (validationResults.TryGetValue(source.Id, out var validation))
                    {
                        <div class="source-validation @(validation.IsValid ? "source-validation-valid" : "source-validation-error")">
                            <strong>@validation.Summary</strong>
                            @if (validation.Details.Count > 0)
                            {
                                <ul>
                                    @foreach (var detail in validation.Details)
                                    {
                                        <li>@detail</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
                <div class="source-actions">
                    <button class="button button-secondary button-small" @onclick="() => BeginEditAsync(source)" disabled="@sourceIsBusy">編輯</button>
                    <button class="button button-secondary button-small" @onclick="() => ValidateAsync(source.Id)" disabled="@sourceIsBusy">@(sourceIsValidating ? "驗證中…" : "驗證")</button>
                    @if (sourceIsCollecting)
                    {
                        <button class="button button-danger button-small" @onclick="() => StopCollectionAsync(source.Id)" disabled="@sourceIsStopping">@(sourceIsStopping ? "正在停止…" : "停止收集")</button>
                    }
                    else
                    {
                        <button class="button button-secondary button-small" @onclick="() => RunNowAsync(source.Id)" disabled="@(source.HealthStatus != SourceHealthStatus.Ready || sourceIsBusy)">立即收集</button>
                    }
                    <button class="button button-secondary button-small" @onclick="() => ToggleAsync(source)" disabled="@sourceIsBusy">@(source.Enabled ? "停用" : "啟用")</button>
                    <details class="source-more-actions">
                        <summary>更多操作</summary>
                        <div>
                            <button class="button button-secondary button-small" @onclick="() => ToggleSourceAiAsync(source)" disabled="@sourceIsBusy">@(source.IncludeInAi ? "停止提供給 AI" : "允許提供給 AI")</button>
                            <button class="button button-secondary button-small" @onclick="() => PrepareReset(source.Id)" disabled="@sourceIsBusy">重設 checkpoint</button>
                            <button class="button button-danger button-small" @onclick="() => ArchiveAsync(source.Id)" disabled="@sourceIsBusy">封存</button>
                        </div>
                    </details>
                </div>
                @if (sourceIsValidating)
                {
                    <OperationProgress Title="正在驗證來源…" Detail="正在檢查執行環境、資料目錄與讀取權限。" />
                }
                @if (sourceIsCollecting)
                {
                    <div class="collection-progress" aria-live="polite">
                        <div><strong>@(sourceIsStopping ? "正在安全停止收集…" : "正在掃描與匯入來源資料…")</strong><span>@(sourceIsStopping ? "正在結束目前的檔案或程序，已完成的資料不會寫入。" : "首次匯入可能需要較長時間；完成後會顯示新增、更新與未變更筆數。")</span></div>
                        <div class="collection-progress-track"><span></span></div>
                    </div>
                }
            </div>
        }
    }
</div>
}

<ConfirmDialog Open="resetSourceId is not null"
               Title="重設這個來源的 checkpoint？"
               Message="下次收集會重新套用首次匯入天數，可能再次掃描較多活動；既有證據、rebase 前 commit 與其他資料都會保留。"
               ConfirmText="確認重設"
               BusyText="重設中…"
               IsBusy="isResettingCheckpoint"
               OnConfirm="ConfirmPendingResetAsync"
               OnCancel="CancelReset" />

@code {
    private SourceWorkspace activeWorkspace = SourceWorkspace.Overview;
    private IReadOnlyList<ActivitySource> sources = [];
    private IReadOnlyList<Project> projects = [];
    private string newName = string.Empty;
    private SourceKind newKind = SourceKind.Git;
    private SourceLocation newLocation = SourceLocation.Native;
    private string newDistro = string.Empty;
