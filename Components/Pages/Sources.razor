    private async Task SourceKindChangedAsync()
    {
        if (newKind != SourceKind.AzureDevOps)
        {
            return;
        }

        newLocation = SourceLocation.Native;
        if (adoScopes.Count == 0)
        {
            adoScopes.Add(new AzureDevOpsScopeForm());
        }

        await DiagnoseAzureDevOpsAsync();
    }

    private void HandleAdoOrganizationInput(ChangeEventArgs args)
    {
        newAdoOrganization = args.Value?.ToString() ?? string.Empty;
        adoDiagnostics = null;
        adoProjects = [];
        adoProjectLoadError = null;
        foreach (var scope in adoScopes)
        {
            scope.ClearSelections();
        }
    }

    private async Task DiagnoseAzureDevOpsAsync()
    {
        if (newKind != SourceKind.AzureDevOps || isLoadingAdoOptions)
        {
            return;
        }

        isLoadingAdoOptions = true;
        try
        {
            adoDiagnostics = await AzureDevOpsCli.DiagnoseAsync(newAdoOrganization);
            if (adoDiagnostics.IsValid && !string.IsNullOrWhiteSpace(newAdoOrganization))
            {
                await LoadAdoProjectsAsync();
            }
        }
        catch (AzureDevOpsCliException exception)
        {
            adoDiagnostics = new AzureDevOpsCliDiagnostics(
                true, null, true, null, false, null, false, false, exception.Message, []);
        }
        finally
        {
            isLoadingAdoOptions = false;
        }
    }

    private async Task LoadAdoProjectsAsync()
    {
        adoProjectLoadError = null;
        try
        {
            adoProjects = await AzureDevOpsCli.GetProjectsAsync(newAdoOrganization);
            foreach (var scope in adoScopes)
            {
                scope.ProjectName = adoProjects.FirstOrDefault(project =>
                    string.Equals(project.Id, scope.ProjectId, StringComparison.OrdinalIgnoreCase))?.Name ?? scope.ProjectName;
                if (scope.ProjectId.Length > 0)
                {
                    await LoadAdoRepositoriesAsync(scope);
                }
            }
        }
        catch (AzureDevOpsCliException exception)
        {
            adoProjects = [];
            adoProjectLoadError = exception.Message;
            Toasts.Error(exception.Message);
        }
    }

    private async Task ChangeAdoProjectAsync(AzureDevOpsScopeForm scope, string? projectId)
    {
        scope.ProjectId = projectId?.Trim() ?? string.Empty;
        scope.ProjectName = adoProjects.FirstOrDefault(project =>
            string.Equals(project.Id, scope.ProjectId, StringComparison.OrdinalIgnoreCase))?.Name ?? string.Empty;
        scope.RepositoryId = string.Empty;
        scope.RepositoryName = string.Empty;
        scope.TargetBranch = string.Empty;
        scope.Repositories.Clear();
        scope.Branches.Clear();
        if (scope.ProjectId.Length > 0)
        {
            await LoadAdoRepositoriesAsync(scope);
        }
    }

    private async Task LoadAdoRepositoriesAsync(AzureDevOpsScopeForm scope)
    {
        if (scope.ProjectId.Length == 0 || string.IsNullOrWhiteSpace(newAdoOrganization))
        {
            return;
        }

        try
        {
            scope.Repositories = (await AzureDevOpsCli.GetRepositoriesAsync(newAdoOrganization, scope.ProjectId)).ToList();
            if (!scope.Repositories.Any(repository => string.Equals(repository.Id, scope.RepositoryId, StringComparison.OrdinalIgnoreCase)))
            {
                scope.RepositoryId = string.Empty;
                scope.RepositoryName = string.Empty;
                scope.Branches.Clear();
                scope.TargetBranch = string.Empty;
            }
            else
            {
                scope.RepositoryName = scope.Repositories.First(repository =>
                    string.Equals(repository.Id, scope.RepositoryId, StringComparison.OrdinalIgnoreCase)).Name;
                scope.Branches = (await AzureDevOpsCli.GetBranchesAsync(
                    newAdoOrganization,
                    scope.ProjectId,
                    scope.RepositoryId)).ToList();
            }
        }
        catch (AzureDevOpsCliException exception)
        {
            Toasts.Error(exception.Message);
        }
    }

    private async Task ChangeAdoRepositoryAsync(AzureDevOpsScopeForm scope, string? repositoryId)
    {
        scope.RepositoryId = repositoryId?.Trim() ?? string.Empty;
        scope.RepositoryName = scope.Repositories.FirstOrDefault(repository =>
            string.Equals(repository.Id, scope.RepositoryId, StringComparison.OrdinalIgnoreCase))?.Name ?? string.Empty;
        scope.TargetBranch = string.Empty;
        scope.Branches.Clear();
        if (scope.RepositoryId.Length == 0)
        {
            return;
        }

        try
        {
            scope.Branches = (await AzureDevOpsCli.GetBranchesAsync(
                newAdoOrganization,
                scope.ProjectId,
                scope.RepositoryId)).ToList();
        }
        catch (AzureDevOpsCliException exception)
        {
            Toasts.Error(exception.Message);
        }
    }

