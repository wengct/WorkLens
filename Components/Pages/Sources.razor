    private async Task BackfillAsync()
    {
        if (isBackfilling)
        {
            return;
        }

        using var cancellation = new CancellationTokenSource();
        backfillCancellation = cancellation;
        isBackfilling = true;
        Toasts.Info("正在回補來源資料…");
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var available = sources.Where(source => source.Enabled && source.HealthStatus == SourceHealthStatus.Ready).Select(source => source.Id);
            var ids = Guid.TryParse(backfillSourceId, out var sourceId) ? [sourceId] : available.ToArray();
            var results = await Orchestrator.CollectRangeAsync(ids, DateOnly.FromDateTime(backfillStart), DateOnly.FromDateTime(backfillEnd), cancellation.Token);
            if (results.Any(result => result.Canceled))
            {
                Toasts.Info("資料回補已停止，未完成的來源不會寫入變更。");
                return;
            }
            var resultMessage = $"回補完成：新增 {results.Sum(result => result.AddedCount)}、更新 {results.Sum(result => result.UpdatedCount)}、未變更 {results.Sum(result => result.UnchangedCount)}。";
            if (results.Any(result => !result.Succeeded)) Toasts.Error(resultMessage);
            else Toasts.Success(resultMessage);
            await ReloadAsync();
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { Toasts.Info("資料回補已停止。"); }
        catch (ArgumentException exception) { SetError(exception.Message); }
        finally
        {
            backfillCancellation = null;
            isBackfilling = false;
        }
    }

    private bool IsStoppingBackfill => backfillCancellation?.IsCancellationRequested == true;

    private void StopBackfill()
    {
        if (backfillCancellation is null || backfillCancellation.IsCancellationRequested)
        {
            return;
        }

        Toasts.Info("正在停止資料回補…");
        backfillCancellation.Cancel();
    }

    private async Task ValidateAsync(Guid id)
    {
        if (!validatingSourceIds.Add(id)) return;
        Toasts.Info("正在驗證來源環境與資料路徑…");
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var result = await Orchestrator.ValidateAsync(id);
            validationResults[id] = result;
            if (result.IsValid)
            {
                Toasts.Success(result.Summary);
            }
            else
            {
                SetError($"{result.Summary} {string.Join(" ", result.Details)}");
            }
        }
        finally
        {
            validatingSourceIds.Remove(id);
            await ReloadAsync();
        }
    }

    private async Task RunNowAsync(Guid id)
    {
        if (!collectingSourceIds.Add(id))
        {
            return;
        }

        var sourceName = sources.FirstOrDefault(source => source.Id == id)?.DisplayName ?? "資料來源";
        Toasts.Info($"「{sourceName}」正在掃描與匯入資料…");
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var result = await Orchestrator.CollectAsync(id);
            if (result.Canceled)
            {
                Toasts.Info($"「{sourceName}」收集已停止，未完成的變更未寫入。");
                return;
            }
            if (result.Succeeded)
            {
                var resultMessage = $"收集完成：新增 {result.AddedCount}、更新 {result.UpdatedCount}、未變更 {result.UnchangedCount}。";
                if (result.Warnings.Count > 0)
                {
                    resultMessage += $" 另有 {result.Warnings.Count} 個警告。";
                }
                Toasts.Success(resultMessage);
            }
            else
            {
                SetError(result.Error ?? string.Join(" ", result.Warnings));
            }
        }
        catch (Exception exception) when (exception is InvalidOperationException or IOException)
        {
            SetError(exception.Message);
        }
        finally
        {
            collectingSourceIds.Remove(id);
            stoppingSourceIds.Remove(id);
            await ReloadAsync();
        }
    }

    private async Task StopCollectionAsync(Guid id)
    {
        if (!stoppingSourceIds.Add(id))
        {
            return;
        }

        if (await Orchestrator.StopCollectionAsync(id))
        {
            Toasts.Info("正在停止來源收集…");
            return;
        }

        stoppingSourceIds.Remove(id);
        Toasts.Info("此來源目前沒有可停止的收集工作。");
    }

