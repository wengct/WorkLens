        ActivitySourceType.WindowsVisualStudioCopilot => (SourceKind.VisualStudioCopilot, SourceLocation.Native),
        ActivitySourceType.AzureDevOpsPullRequest => (SourceKind.AzureDevOps, SourceLocation.Native),
        _ => throw new ArgumentOutOfRangeException(nameof(type), type, null)
