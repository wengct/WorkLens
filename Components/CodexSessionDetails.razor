@using WorkLens.Domain

@if (metadata is not null)
{
    <details class="codex-session-details">
        <summary>
            查看完整對話（@metadata.Messages.Count 則）
            @if (metadata.Archived)
            {
                <span> · 已在 Codex 封存</span>
            }
        </summary>
        <div class="codex-session-meta">
            @if (!string.IsNullOrWhiteSpace(metadata.Cwd))
            {
                <span>工作目錄：@metadata.Cwd</span>
            }
            <span>最近更新：@metadata.UpdatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
            @if (metadata.AttachmentCount > 0)
            {
                <span>附件：@metadata.AttachmentCount（未複製檔案）</span>
            }
        </div>
        <div class="codex-transcript">
            @foreach (var message in metadata.Messages)
            {
                <div class="codex-message codex-message-@message.Role">
                    <div class="codex-message-heading">
                        <strong>@RoleText(message.Role)</strong>
                        <span>@message.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                    </div>
                    <div class="codex-message-body">@message.Text</div>
                </div>
            }
        </div>
    </details>
}
else if (!string.IsNullOrWhiteSpace(Evidence.CommitMessage))
{
    <div class="markdown-source">@Evidence.CommitMessage</div>
}

@code {
    [Parameter, EditorRequired] public SourceEvidence Evidence { get; set; } = default!;
    private CodexSessionMetadata? metadata;

    protected override void OnParametersSet() =>
        metadata = SourceSettingsSerializer.DeserializeCodexMetadata(Evidence.MetadataJson);

    private static string RoleText(string role) => role == "user" ? "User" : "Codex";
}
