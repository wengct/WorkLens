@inject ReportService ReportService
@inject PromptTemplateService PromptTemplates
@inject ILogger<ReportWorkspace> Logger
@inject IJSRuntime JS
@inject ToastService Toasts
@implements IAsyncDisposable

<NavigationLock OnBeforeInternalNavigation="BeforeNavigationAsync" />

<div class="ai-progress-host @(isGeneratingAi ? "is-active" : null)" aria-hidden="@(!isGeneratingAi)">
    <OperationProgress Title="AI 正在整理摘要"
                       Detail="通常會在 90 秒內完成；逾時或取消時會保留原內容。"
                       Overlay="true"
                       ImageSource="/images/ai-generating.webp"
                       ImageAlt="AI 正在整理摘要的等待動畫">
        <Actions><button class="button button-secondary" type="button" @onclick="CancelAiGeneration">取消整理</button></Actions>
    </OperationProgress>
</div>

<section class="panel report-workspace" aria-label="工作摘要編輯區">
    <div class="panel-heading">
        <div>
            <p class="eyebrow">@KindText 摘要</p>
            <h2>@PeriodTitle</h2>
            <p>@StatusText</p>
        </div>
        <span class="@StatusClass">@StatusShort</span>
    </div>

    <p class="report-scope-note">摘要涵蓋完整@(Kind == ReportKind.Daily ? "日期" : "週期")，不受左側歷程篩選影響。</p>

    <div class="button-row report-primary-actions">
        <button class="button button-primary" type="button" @onclick="PrepareAiAsync" disabled="@IsBusy">@(isGeneratingAi ? "AI 整理中…" : report is null ? "產生 AI 摘要" : "重新用 AI 整理")</button>
        @if (report is not null)
        {
            <button class="button button-secondary button-small" type="button" @onclick="CopyReportAsync" disabled="@(string.IsNullOrEmpty(report.Body) || IsBusy)">複製內容</button>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(aiAvailabilityError))
    {
        <p class="alert alert-warning">@aiAvailabilityError <a href="/ai">前往 AI 設定</a></p>
    }

    @if (isGeneratingReport)
    {
        <OperationProgress Title="正在產生摘要…" Detail="正在彙整人工紀錄與來源活動，完成後會開啟最新內容。" />
    }

    @if (report is null && !isGeneratingReport)
    {
        <div class="empty-state report-empty"><p>這個期間尚未產生摘要。可直接用 AI 整理；系統會先建立基本摘要作為起點。</p></div>
    }
    else if (report is not null)
    {
        <textarea id="report-body-editor" class="report-body" @bind="report.Body" aria-label="工作摘要內容"></textarea>
        <div class="report-ai-controls">
            <section class="report-prompt-picker" aria-labelledby="report-prompt-heading">
                <h3 id="report-prompt-heading" class="report-control-heading">整理方式：@(selectedPromptId is null ? "使用系統設定" : "自訂範本")</h3>
                <div class="field"><label for="manual-report-prompt">選擇整理方式</label><select id="manual-report-prompt" value="@SelectedPromptValue" @onchange="SetSelectedPrompt" disabled="@IsBusy"><option value="">使用系統設定</option>@foreach (var prompt in promptOptions) { <option value="@prompt.Id">@prompt.Name</option> }</select></div>
            </section>
            <div class="button-row report-editor-actions"><button class="button button-secondary" @onclick="SaveChangesAsync" disabled="@IsBusy">儲存文字</button></div>
            <section class="report-secondary-actions" aria-labelledby="report-secondary-actions-heading">
                <h3 id="report-secondary-actions-heading" class="report-control-heading">其他操作</h3>
                <div class="button-row"><button class="button button-secondary button-small" type="button" @onclick="GenerateAsync" disabled="@IsBusy">產生基本摘要</button><button class="button button-secondary button-small" type="button" @onclick="DownloadMarkdownAsync" disabled="@IsBusy">下載 Markdown</button><button class="button button-secondary button-small" type="button" @onclick="DownloadCsvAsync" disabled="@IsBusy">下載 CSV</button>@if (previousRevision is not null) { <button class="button button-secondary button-small" type="button" @onclick="RestorePreviousAsync" disabled="@IsBusy">還原上一版（@previousRevision.CapturedAt.LocalDateTime.ToString("yyyy/MM/dd HH:mm")）</button> }</div>
            </section>
        </div>
    }
</section>

@if (pendingAiPreparation is not null)
{
    <div class="modal-backdrop sensitive-preview-backdrop" role="presentation">
        <section class="modal-dialog sensitive-preview-dialog" role="dialog" aria-modal="true" aria-labelledby="sensitive-preview-title">
            <div class="modal-heading">
                <div><p class="eyebrow">送出前檢查</p><h2 id="sensitive-preview-title">已自動遮蔽機敏資訊</h2></div>
                <button class="modal-close" type="button" aria-label="取消" @onclick="CancelSensitivePreview" disabled="@isGeneratingAi">×</button>
            </div>
            <p class="confirm-dialog-message">原始工作紀錄與來源資料未修改。以下內容只會以遮蔽副本送出 AI。</p>
            <ul class="sensitive-notice-list">
                @foreach (var notice in pendingAiPreparation.Request.Sanitization.Notices)
                {
                    <li>@SensitiveSegmentText(notice.Segment)：@SensitiveCategoryText(notice.Category) @notice.Count 處</li>
                }
            </ul>
            <SensitiveContentPreview InputMarkdown="@pendingAiPreparation.Request.InputMarkdown"
                                     PreviewValues="@pendingAiPreparation.PreviewValues"
                                     EffectivePrompt="@pendingAiPreparation.Request.EffectivePrompt" />
            <div class="modal-actions">
                <button class="button button-secondary" type="button" @onclick="CancelSensitivePreview" disabled="@isGeneratingAi">取消</button>
                <button class="button button-primary" type="button" @onclick="SendPreparedAiAsync" disabled="@isGeneratingAi">@(isGeneratingAi ? "整理中…" : "遮蔽後送出")</button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public ReportKind Kind { get; set; }
    [Parameter, EditorRequired] public DateOnly AnchorDate { get; set; }
    [Parameter] public EventCallback OnReportChanged { get; set; }

    private ReportDocument? report;
    private ReportKind loadedKind;
    private string loadedKey = string.Empty;
    private string savedBody = string.Empty;
    private bool isGeneratingReport;
    private bool isGeneratingAi;
    private bool editorAttached;
    private AiPreparedReport? pendingAiPreparation;
    private CancellationTokenSource? aiCancellation;
    private IReadOnlyList<PromptTemplate> promptOptions = [];
    private Guid? selectedPromptId;
    private ReportRevision? previousRevision;
    private string? aiAvailabilityError;
    private string SelectedPromptValue => selectedPromptId?.ToString() ?? string.Empty;

    public bool HasUnsavedChanges => report is not null && report.Body != savedBody;
    private bool IsBusy => isGeneratingReport || isGeneratingAi;
    private DateOnly PeriodStart => Kind == ReportKind.Daily ? AnchorDate : StartOfWeek(AnchorDate);
    private string PeriodKey => Kind == ReportKind.Daily ? AnchorDate.ToString("yyyy-MM-dd") : ReportInvalidationService.GetWeeklyKey(AnchorDate);
    private string KindText => Kind == ReportKind.Daily ? "每日" : "每週";
    private string PeriodTitle => Kind == ReportKind.Daily
        ? AnchorDate.ToString("yyyy/MM/dd")
        : $"{PeriodStart:yyyy/MM/dd}－{PeriodStart.AddDays(6):MM/dd}";
    private string StatusShort => report is null ? "未產生" : report.IsStale ? "需重產" : "最新";
    private string StatusText => report is null ? "尚未建立這個期間的摘要。" : report.IsStale ? "原始資料已有異動，請確認後重產。" : "內容與目前資料同步。";
    private string StatusClass => $"calendar-report-state {(report is null ? "calendar-report-none" : report.IsStale ? "calendar-report-stale" : "calendar-report-ready")}";

    protected override async Task OnParametersSetAsync()
    {
        if (promptOptions.Count == 0) promptOptions = await PromptTemplates.GetAllAsync(includeArchived: false);
        if (loadedKind == Kind && loadedKey == PeriodKey) return;
        loadedKind = Kind;
        loadedKey = PeriodKey;
        report = await ReportService.GetForPeriodAsync(Kind, PeriodKey);
        savedBody = report?.Body ?? string.Empty;
        previousRevision = report is null ? null : await ReportService.GetPreviousRevisionAsync(report.Id);
    }

    public void DiscardChanges()
    {
        if (report is not null) report.Body = savedBody;
    }

    public async Task<bool> SaveChangesAsync()
    {
        if (report is null || !HasUnsavedChanges) return true;
        try
        {
            report = await ReportService.UpdateBodyAsync(report.Id, report.Body, report.UpdateVersion);
            savedBody = report?.Body ?? string.Empty;
            previousRevision = report is null ? null : await ReportService.GetPreviousRevisionAsync(report.Id);
            await JS.InvokeVoidAsync("workLensReportEditor.markSaved", "report-body-editor");
            Toasts.Success("摘要文字已儲存。");
            await OnReportChanged.InvokeAsync();
            return true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Saving report body failed");
            Toasts.Error("摘要文字儲存失敗，請稍後再試。");
            return false;
        }
    }

    private async Task GenerateAsync()
    {
        if (IsBusy) return;
        if (!await SaveChangesAsync()) return;
        isGeneratingReport = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            report = Kind == ReportKind.Daily
                ? await ReportService.GenerateDeterministicAsync(AnchorDate)
                : await ReportService.GenerateWeeklyAsync(AnchorDate);
            savedBody = report.Body;
            previousRevision = await ReportService.GetPreviousRevisionAsync(report.Id);
            await JS.InvokeVoidAsync("workLensReportEditor.markSaved", "report-body-editor");
            Toasts.Success("摘要已產生。");
            await OnReportChanged.InvokeAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Deterministic report generation failed");
            Toasts.Error("摘要產生失敗，請稍後再試。");
        }
        finally
        {
            isGeneratingReport = false;
        }
    }

    private async Task CopyReportAsync()
    {
        if (report is null || string.IsNullOrEmpty(report.Body)) return;
        if (!await SaveChangesAsync()) return;
        try
        {
            await JS.InvokeVoidAsync("workLensClipboard.copyText", report.Body);
            Toasts.Success("摘要內容已複製到剪貼簿。");
        }
        catch (JSException exception)
        {
            Logger.LogWarning(exception, "Copying report to clipboard failed");
            Toasts.Error("無法複製摘要內容，請確認瀏覽器已允許剪貼簿權限。");
        }
    }

    private async Task DownloadMarkdownAsync()
    {
        if (report is null || !await SaveChangesAsync()) return;
        await JS.InvokeVoidAsync("open", $"/reports/{report.Id}/markdown", "_blank");
    }

    private async Task DownloadCsvAsync()
    {
        if (report is null || !await SaveChangesAsync()) return;
        await JS.InvokeVoidAsync("open", $"/reports/{report.Id}/csv", "_blank");
    }

    private async Task RestorePreviousAsync()
    {
        if (report is null || !await SaveChangesAsync()) return;
        try
        {
            report = await ReportService.RestorePreviousAsync(report.Id, report.UpdateVersion);
            savedBody = report?.Body ?? string.Empty;
            previousRevision = report is null ? null : await ReportService.GetPreviousRevisionAsync(report.Id);
            await JS.InvokeVoidAsync("workLensReportEditor.markSaved", "report-body-editor");
            Toasts.Success("已還原上一版摘要；目前內容標示為需確認。再次還原可撤回這次操作。");
            await OnReportChanged.InvokeAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Restoring previous report revision failed");
            Toasts.Error("還原上一版失敗，請重新載入後再試。");
        }
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (HasUnsavedChanges && !await SaveChangesAsync()) context.PreventNavigation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (report is null) return;
        if (!editorAttached)
        {
            await JS.InvokeVoidAsync("workLensReportEditor.attach", "report-body-editor");
            editorAttached = true;
        }
        if (!HasUnsavedChanges) await JS.InvokeVoidAsync("workLensReportEditor.markSaved", "report-body-editor");
    }

    public async ValueTask DisposeAsync()
    {
        aiCancellation?.Cancel();
        aiCancellation?.Dispose();
        if (editorAttached)
        {
            try { await JS.InvokeVoidAsync("workLensReportEditor.detach", "report-body-editor"); }
            catch (Exception exception) when (exception is JSException or JSDisconnectedException) { }
        }
    }

    private async Task PrepareAiAsync()
    {
        if (isGeneratingAi || !await SaveChangesAsync()) return;
        isGeneratingAi = true;
        aiCancellation = new CancellationTokenSource();
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            aiAvailabilityError = null;
            report = await ReportService.EnsureForAiAsync(Kind, AnchorDate, aiCancellation.Token);
            savedBody = report.Body;
            var preparation = await ReportService.PrepareWithAiAsync(report.Id, selectedPromptId, aiCancellation.Token);
            if (aiCancellation.IsCancellationRequested)
            {
                Toasts.Info("已取消 AI 整理，原內容已保留。");
            }
            else if (!preparation.Succeeded)
            {
                aiAvailabilityError = preparation.Error;
                Toasts.Error(preparation.Error ?? "機敏資訊檢查未完成，原內容已保留。");
            }
            else if (preparation.Sanitization.Status == AiSanitizationStatus.Redacted)
            {
                pendingAiPreparation = preparation.PreparedReport;
            }
            else
            {
                pendingAiPreparation = preparation.PreparedReport;
                await SendPreparedAiCoreAsync();
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "AI report generation failed");
            Toasts.Error("AI 整理發生未預期錯誤，原內容已保留。");
        }
        finally
        {
            aiCancellation.Dispose();
            aiCancellation = null;
            isGeneratingAi = false;
        }
    }

    private async Task SendPreparedAiAsync()
    {
        if (pendingAiPreparation is null || isGeneratingAi) return;
        var prepared = pendingAiPreparation;
        pendingAiPreparation = null;
        isGeneratingAi = true;
        aiCancellation = new CancellationTokenSource();
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await SendPreparedAiCoreAsync(prepared);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Sending prepared AI report failed");
            Toasts.Error("AI 整理發生未預期錯誤，原內容已保留。");
        }
        finally
        {
            aiCancellation.Dispose();
            aiCancellation = null;
            isGeneratingAi = false;
        }
    }

    private async Task SendPreparedAiCoreAsync(AiPreparedReport? preparedRequest = null)
    {
        var prepared = preparedRequest ?? pendingAiPreparation;
        if (prepared is null) return;
        pendingAiPreparation = null;
        var result = await ReportService.SendPreparedWithAiAsync(prepared, aiCancellation?.Token ?? CancellationToken.None);
        if (aiCancellation?.IsCancellationRequested == true)
        {
            Toasts.Info("已取消 AI 整理，原內容已保留。");
        }
        else if (result.Succeeded)
        {
            aiAvailabilityError = null;
            report = await ReportService.GetAsync(prepared.ReportId);
            savedBody = report?.Body ?? string.Empty;
            previousRevision = report is null ? null : await ReportService.GetPreviousRevisionAsync(report.Id);
            await JS.InvokeVoidAsync("workLensReportEditor.markSaved", "report-body-editor");
            var suffix = result.Sanitization?.Status == AiSanitizationStatus.Redacted
                ? "（已自動遮蔽機敏資訊）"
                : string.Empty;
            Toasts.Success($"AI 整理完成並已儲存{suffix}，請確認內容。");
            await OnReportChanged.InvokeAsync();
        }
        else
        {
            Toasts.Error(result.Error ?? "AI 整理失敗，原內容已保留。");
        }
    }

    private void CancelAiGeneration() => aiCancellation?.Cancel();
    private void SetSelectedPrompt(ChangeEventArgs args) => selectedPromptId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
    private void CancelSensitivePreview() => pendingAiPreparation = null;
    private static string SensitiveSegmentText(string segment) => segment;
    private static string SensitiveCategoryText(AiSensitiveDataCategory category) => category switch
    {
        AiSensitiveDataCategory.Credential => "機敏憑證",
        AiSensitiveDataCategory.PersonalData => "個人資料",
        _ => "自訂敏感詞"
    };
    private static DateOnly StartOfWeek(DateOnly day) => day.AddDays(-(int)day.DayOfWeek + (day.DayOfWeek == DayOfWeek.Sunday ? -6 : 1));
}
