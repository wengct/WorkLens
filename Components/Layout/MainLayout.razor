@inherits LayoutComponentBase
@implements IDisposable
@inject StartupHealth StartupHealth
@inject ReleaseUpdateService ReleaseUpdates
@inject IJSRuntime JS
@inject ToastService Toasts

<ToastContainer />

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <img class="brand-mark" src="brand-mark.png" alt="" width="35" height="35" />
            <div>
                <strong>WorkLens</strong>
                <small>工作摘要與回報</small>
            </div>
        </div>
        <NavMenu />
        <div class="sidebar-footer">
            <div class="sidebar-meta-row">
                <a class="sidebar-github-link"
                   href="https://github.com/wengct/WorkLens"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="在 GitHub 上查看 WorkLens（另開新視窗）">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.68 0-1.25.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.96 10.96 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.09 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
                    </svg>
                    <span>GitHub</span>
                </a>
                @if (updateStatus?.IsUpdateAvailable == true)
                {
                    <button class="sidebar-update-link" type="button" @onclick="OpenUpdateDialog"
                            aria-haspopup="dialog">有新版本 @updateStatus.LatestVersion</button>
                }
                else
                {
                    <div class="sidebar-version">版本 v@(StartupHealth.Version)</div>
                }
            </div>
        </div>
    </aside>
    <main class="main-content">
        <div class="content-container">
            @Body
        </div>
    </main>
</div>

@if (showUpdateDialog && updateStatus?.IsUpdateAvailable == true)
{
    <div class="modal-backdrop" role="presentation" @onclick="CloseUpdateDialog">
        <section class="modal-dialog update-dialog" role="dialog" aria-modal="true"
                 aria-labelledby="update-dialog-title" @onclick:stopPropagation>
            <div class="modal-heading">
                <div>
                    <p class="eyebrow">版本更新</p>
                    <h2 id="update-dialog-title">WorkLens @updateStatus.LatestVersion 已發布</h2>
                    <p>目前版本為 v@(updateStatus.CurrentVersion)。請複製下列指令，並在終端機中自行執行更新。</p>
                </div>
                <button class="modal-close" type="button" aria-label="關閉" @onclick="CloseUpdateDialog">×</button>
            </div>
            <p class="update-command-label">@(OperatingSystem.IsWindows() ? "Windows PowerShell" : "macOS Terminal")</p>
            <pre class="code-block update-command"><code>@InstallCommand</code></pre>
            <p class="hint">安裝器會保留工作資料；新版健康檢查失敗時會自動回復上一版。</p>
            <div class="modal-actions">
                @if (!string.IsNullOrWhiteSpace(updateStatus.ReleaseUrl))
                {
                    <a class="button button-secondary" href="@updateStatus.ReleaseUrl" target="_blank"
                       rel="noopener noreferrer">查看更新內容</a>
                }
                <button class="button button-secondary" type="button" @onclick="CloseUpdateDialog">稍後再說</button>
                <button class="button" type="button" @onclick="CopyInstallCommandAsync">複製安裝指令</button>
            </div>
        </section>
    </div>
}

@code {
    private const string WindowsInstallCommand = "irm https://raw.githubusercontent.com/wengct/WorkLens/main/scripts/get.ps1 | iex";
    private const string MacOsInstallCommand = "curl -fsSL https://raw.githubusercontent.com/wengct/WorkLens/main/scripts/get.sh | bash";
    private readonly CancellationTokenSource disposal = new();
    private ReleaseUpdateStatus? updateStatus;
    private bool showUpdateDialog;

    private string InstallCommand => OperatingSystem.IsWindows() ? WindowsInstallCommand : MacOsInstallCommand;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            updateStatus = await ReleaseUpdates.CheckAsync(disposal.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (disposal.IsCancellationRequested)
        {
        }
    }

    private void OpenUpdateDialog() => showUpdateDialog = true;
    private void CloseUpdateDialog() => showUpdateDialog = false;

    private async Task CopyInstallCommandAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("workLensClipboard.copyText", InstallCommand);
            Toasts.Success("安裝指令已複製，請貼到終端機執行。");
        }
        catch (JSException)
        {
            Toasts.Error("無法複製安裝指令，請手動選取並複製。");
        }
    }

    public void Dispose()
    {
        disposal.Cancel();
        disposal.Dispose();
    }
}
