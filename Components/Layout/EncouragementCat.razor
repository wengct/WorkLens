@implements IAsyncDisposable
@inject IJSRuntime JS
@inject EncouragementQuoteService Quotes

<aside @ref="element" class="encouragement-cat" data-state="hidden" aria-label="工作中的小小鼓勵">
    <button class="encouragement-cat-trigger" type="button" data-cat-trigger
            aria-label="發現小貓，看看牠的鼓勵" aria-expanded="false"
            aria-controls="cat-encouragement-bubble" @onclick="NextQuote">
        <span class="encouragement-cat-clip">
            <svg class="encouragement-cat-art" viewBox="0 0 100 100" aria-hidden="true">
                <g class="cat-head">
                    <path class="cat-fur" d="M15 45 12 12Q12 7 18 11L38 26Q50 22 62 26L82 11Q88 7 88 13L85 46Q94 60 87 77Q80 92 50 92T13 77Q6 59 15 45Z" />
                    <path class="cat-ear" d="m19 20 3 23 12-13Z" />
                    <path class="cat-ear cat-ear-right" d="m81 20-3 23-12-13Z" />
                    <g class="cat-eyes">
                        <ellipse cx="34" cy="57" rx="3" ry="4" />
                        <ellipse cx="66" cy="57" rx="3" ry="4" />
                    </g>
                    <path class="cat-happy-eyes" d="M30 58q4-7 8 0m24 0q4-7 8 0" />
                    <path class="cat-face" d="m47 65 3 2 3-2M50 67v3q-5 7-9 0m9 0q5 7 9 0M10 60l12 3M9 70l12-1M78 63l12-3M79 69l12 1" />
                    <ellipse class="cat-cheek" cx="26" cy="68" rx="6" ry="3" />
                    <ellipse class="cat-cheek" cx="74" cy="68" rx="6" ry="3" />
                </g>
                <g class="cat-paws">
                    <g class="cat-waving-paw">
                        <path class="cat-fur" d="M20 91q-6-17 7-18t13 18q-9 7-20 0Z" />
                        <path class="cat-face" d="M27 86v7m6-7v7" />
                    </g>
                    <path class="cat-fur" d="M60 91q-6-17 7-18t13 18q-9 7-20 0Z" />
                    <path class="cat-face" d="M67 86v7m6-7v7" />
                </g>
                <g class="cat-found-sparkles"><path d="m5 32 2-5 2 5 5 2-5 2-2 5-2-5-5-2Zm83 4 2-4 2 4 4 2-4 2-2 4-2-4-4-2Z" /></g>
            </svg>
        </span>
        <span class="encouragement-cat-hint" aria-hidden="true">被你發現了</span>
    </button>
    <section id="cat-encouragement-bubble" class="encouragement-cat-bubble" hidden
             aria-labelledby="cat-encouragement-title">
        <div class="encouragement-cat-surface">
            <div class="encouragement-cat-heading">
                <span class="encouragement-cat-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><ellipse cx="7" cy="7" rx="2.4" ry="3" /><ellipse cx="17" cy="7" rx="2.4" ry="3" /><ellipse cx="3.5" cy="12" rx="2" ry="2.5" /><ellipse cx="20.5" cy="12" rx="2" ry="2.5" /><path d="M6 18c0-3 3-7 6-7s6 4 6 7c0 4-4 2-6 2s-6 2-6-2Z" /></svg>
                </span>
                <div><span class="encouragement-cat-eyebrow">休息一下，聽我說</span><h2 id="cat-encouragement-title">小貓的悄悄話</h2></div>
                <button class="encouragement-cat-dismiss" type="button" data-cat-close aria-label="關閉小貓的悄悄話">×</button>
            </div>
            <p class="encouragement-cat-quote" role="status" aria-live="polite" aria-atomic="true">@quote?.Text</p>
            <div class="encouragement-cat-actions">
                @if (Quotes.CanChange)
                {
                    <button class="button button-secondary" type="button" @onclick="NextQuote"><span aria-hidden="true">↻</span> 再來一句</button>
                }
                <button class="button encouragement-cat-thanks" type="button" data-cat-close>收到，謝謝你</button>
            </div>
            <button class="encouragement-cat-rest" type="button" data-cat-rest>讓小貓本次先休息</button>
        </div>
    </section>
</aside>

@code {
    private ElementReference element;
    private IJSObjectReference? module;
    private EncouragementQuote? quote;
    private bool disposed;

    protected override void OnInitialized() => NextQuote();

    private void NextQuote() => quote = Quotes.Next(quote?.Id);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        try
        {
            if (firstRender)
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/encouragement-cat.js");
                if (disposed)
                {
                    await module.DisposeAsync();
                    module = null;
                    return;
                }
                await module.InvokeVoidAsync("initialize", element);
            }
            else if (module is not null)
            {
                await module.InvokeVoidAsync("refresh", element);
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { /* An optional companion must not interrupt the workspace. */ }
        catch (TaskCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is null) return;
        try
        {
            await module.InvokeVoidAsync("dispose", element);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }
}
