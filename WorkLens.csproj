<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Compile Remove="site\**" />
    <Content Remove="site\**" />
    <None Remove="site\**" />
    <EmbeddedResource Remove="site\**" />
  </ItemGroup>

  <!-- The Windows development build uses the same verified scanner layout as the release package. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="tools\leak-hunter\leak-hunter.exe"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
    <None Include="scripts\leak-hunter.version"
          Link="scripts\leak-hunter.version"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
