[
  { "id": "work-001", "category": "進度", "text": "今天完成的一小步，也是在替明天減輕負擔。" },
  { "id": "work-002", "category": "進度", "text": "待辦清單還沒清空，不代表今天的你不夠努力。" },
  { "id": "work-006", "category": "進度", "text": "不必一次解決所有問題，先找到下一個能做的小步驟。" },
  { "id": "work-008", "category": "進度", "text": "今天沒有亮眼的成果，也可能默默排除了一個重要的障礙。" },
  { "id": "work-017", "category": "進度", "text": "還沒完成，不代表之前的努力沒有意義。" },
  { "id": "work-018", "category": "進度", "text": "把大任務拆小一點，開始就不會那麼困難。" },
  { "id": "work-019", "category": "進度", "text": "進度慢一點沒關係，找到方向也需要時間。" },
  { "id": "work-020", "category": "進度", "text": "今天先做到這裡，也可以是一個合理的決定。" },
  { "id": "work-021", "category": "進度", "text": "不起眼的整理，常常讓後面的工作順利許多。" },
  { "id": "work-022", "category": "進度", "text": "每解開一個小問題，都值得在心裡替自己打個勾。" },
  { "id": "work-023", "category": "進度", "text": "有些工作看不到成果，卻讓很多事情沒有出錯。" },
  { "id": "work-024", "category": "進度", "text": "能把混亂理清一點，就是今天的貢獻。" },
  { "id": "work-025", "category": "進度", "text": "一時還沒答案，也可以先記下已經知道的事。" },
  { "id": "work-026", "category": "進度", "text": "先完成一個能用的版本，再慢慢把它做好。" },
  { "id": "work-027", "category": "進度", "text": "今天的進步，也許只是比昨天少繞了一點路。" },
  { "id": "work-028", "category": "進度", "text": "做得少但做得踏實，也是一種前進。" },
  { "id": "work-029", "category": "進度", "text": "不是每一天都適合衝刺，維持步調也很好。" },
  { "id": "work-030", "category": "進度", "text": "看看已完成的事，別只盯著還沒完成的部分。" },
  { "id": "work-031", "category": "進度", "text": "當你願意開始，事情就有了往前走的機會。" },
  { "id": "work-032", "category": "進度", "text": "一件一件來，你不需要同時抵達所有終點。" },
  { "id": "work-003", "category": "休息", "text": "卡住時先休息一下，有時候答案需要一點空白。" },
  { "id": "work-004", "category": "休息", "text": "你可以認真工作，也可以準時下班。" },
  { "id": "work-010", "category": "休息", "text": "工作可以有優先順序，你的休息也值得排進去。" },
  { "id": "work-013", "category": "休息", "text": "把事情做好很重要，把自己照顧好也是。" },
  { "id": "work-014", "category": "休息", "text": "偶爾效率不好，是人的日常，不是你的缺陷。" },
  { "id": "work-033", "category": "休息", "text": "午餐值得好好吃，訊息可以等你吃完再回。" },
  { "id": "work-034", "category": "休息", "text": "眼睛離開螢幕一下，看看今天窗外的光。" },
  { "id": "work-035", "category": "休息", "text": "肩膀可以放鬆一點，你已經用力很久了。" },
  { "id": "work-036", "category": "休息", "text": "喝口水吧，不必等到完成一件事才照顧自己。" },
  { "id": "work-037", "category": "休息", "text": "休息不需要靠加班來換取。" },
  { "id": "work-038", "category": "休息", "text": "累了就調整步調，不必責怪自己走得不夠快。" },
  { "id": "work-039", "category": "休息", "text": "今天的電量比較少，就先照顧最重要的事情。" },
  { "id": "work-040", "category": "休息", "text": "下班後的你，也有值得花時間的生活。" },
  { "id": "work-041", "category": "休息", "text": "留一點空白，讓腦袋有機會喘口氣。" },
  { "id": "work-042", "category": "休息", "text": "不是每一段空檔，都需要塞進一件工作。" },
  { "id": "work-043", "category": "休息", "text": "站起來走走，有時候換個姿勢也能換個思路。" },
  { "id": "work-044", "category": "休息", "text": "能長久走下去的節奏，比偶爾衝很快更適合你。" },
  { "id": "work-045", "category": "休息", "text": "照顧身體，是每天都值得安排的小事。" },
  { "id": "work-015", "category": "休息", "text": "今天辛苦了，未完成的事情可以留給明天接棒。" },
  { "id": "work-046", "category": "休息", "text": "把電腦闔上，也是在好好完成今天。" },
  { "id": "work-005", "category": "合作", "text": "遇到不懂的事情，提問也是推進工作的一種方式。" },
  { "id": "work-012", "category": "合作", "text": "不需要每件事都自己扛，好的合作從願意求助開始。" },
  { "id": "work-047", "category": "合作", "text": "說清楚自己的困難，能讓合作更有方向。" },
  { "id": "work-048", "category": "合作", "text": "你不必立刻回答所有問題，可以先想一想。" },
  { "id": "work-049", "category": "合作", "text": "確認彼此的理解，值得多花幾分鐘。" },
  { "id": "work-050", "category": "合作", "text": "一句「謝謝你幫忙」，也能讓工作日暖一點。" },
  { "id": "work-051", "category": "合作", "text": "願意聽完別人的想法，本身就是一份尊重。" },
  { "id": "work-052", "category": "合作", "text": "把需求問清楚，能替彼此省下很多猜測。" },
  { "id": "work-053", "category": "合作", "text": "提出不同意見，也可以是對成果負責。" },
  { "id": "work-054", "category": "合作", "text": "說出目前能做到的範圍，讓承諾更踏實。" },
  { "id": "work-055", "category": "合作", "text": "團隊的成果，不必由一個人撐起全部。" },
  { "id": "work-056", "category": "合作", "text": "你整理好的資訊，可能正是同事需要的幫助。" },
  { "id": "work-057", "category": "合作", "text": "有些問題適合一起想，不必獨自悶著找答案。" },
  { "id": "work-058", "category": "合作", "text": "清楚地說「我需要一點時間」，是可以的。" },
  { "id": "work-059", "category": "合作", "text": "不同的工作方式，可以透過溝通找到交會點。" },
  { "id": "work-060", "category": "合作", "text": "說明限制，不等於推卸責任。" },
  { "id": "work-061", "category": "合作", "text": "能放心說出「我還不會」，才有一起學習的空間。" },
  { "id": "work-062", "category": "合作", "text": "好的交接，是留給下一個人的一份體貼。" },
  { "id": "work-063", "category": "合作", "text": "你可以樂於助人，也可以保留自己的時間。" },
  { "id": "work-064", "category": "合作", "text": "在忙碌的一天裡，也別忘了謝謝願意配合的自己。" },
  { "id": "work-007", "category": "成長", "text": "修改很多次不代表白費，每一次都讓方向更清楚。" },
  { "id": "work-065", "category": "成長", "text": "不熟悉的工作做得慢，是很自然的事。" },
  { "id": "work-066", "category": "成長", "text": "發現錯誤的這一刻，也是開始修正的時刻。" },
  { "id": "work-067", "category": "成長", "text": "一次不順利的結果，無法概括你的能力。" },
  { "id": "work-068", "category": "成長", "text": "把經驗記下來，下次就多一份可以依靠的線索。" },
  { "id": "work-069", "category": "成長", "text": "學會一個小方法，也值得開心一下。" },
  { "id": "work-070", "category": "成長", "text": "可以先查資料，不必逼自己什麼都記得。" },
  { "id": "work-011", "category": "成長", "text": "有些成果還沒被看見，但你累積的能力會留下來。" },
  { "id": "work-071", "category": "成長", "text": "願意重新確認，比勉強裝懂更有幫助。" },
  { "id": "work-072", "category": "成長", "text": "走過的彎路，也能成為下次判斷的依據。" },
  { "id": "work-073", "category": "成長", "text": "你可以承認做錯，同時善待正在改進的自己。" },
  { "id": "work-074", "category": "成長", "text": "問題很難，不代表你不夠好。" },
  { "id": "work-075", "category": "成長", "text": "當原本的方法行不通，換一條路也算前進。" },
  { "id": "work-076", "category": "成長", "text": "不用今天就精通，先比剛開始時多懂一點。" },
  { "id": "work-077", "category": "成長", "text": "把「我不會」換成「我先看看怎麼做」，給自己一個起點。" },
  { "id": "work-078", "category": "成長", "text": "願意試一個小實驗，就可能找到新的線索。" },
  { "id": "work-079", "category": "成長", "text": "回頭檢查，是為了理解，不是為了責備自己。" },
  { "id": "work-080", "category": "成長", "text": "今天問過的問題，可能讓明天的你少卡住一次。" },
  { "id": "work-081", "category": "成長", "text": "做完後留下一點筆記，是送給未來自己的幫助。" },
  { "id": "work-082", "category": "成長", "text": "有時候進步，就是更早察覺自己需要幫忙。" },
  { "id": "work-009", "category": "鼓勵", "text": "別人的進度是參考，不是衡量你價值的尺。" },
  { "id": "work-016", "category": "鼓勵", "text": "你的價值，比一份報表、一個績效數字更大。" },
  { "id": "work-083", "category": "鼓勵", "text": "不必每一天都表現出色，你也值得被好好對待。" },
  { "id": "work-084", "category": "鼓勵", "text": "今天心情不太好，也不用勉強自己看起來充滿幹勁。" },
  { "id": "work-085", "category": "鼓勵", "text": "面對很多期待時，先分清楚哪些是你能負責的。" },
  { "id": "work-086", "category": "鼓勵", "text": "有些事情超出你的控制，先把能做的部分做好。" },
  { "id": "work-087", "category": "鼓勵", "text": "忙碌的時候，更需要替自己留一點耐心。" },
  { "id": "work-088", "category": "鼓勵", "text": "沒有人稱讚的努力，你也可以自己看見。" },
  { "id": "work-089", "category": "鼓勵", "text": "今天撐過一場困難的討論，也是一件不容易的事。" },
  { "id": "work-090", "category": "鼓勵", "text": "你可以在意工作成果，也可以不把每次失誤放在心上太久。" },
  { "id": "work-091", "category": "鼓勵", "text": "不用靠一直忙碌，證明自己值得留在這裡。" },
  { "id": "work-092", "category": "鼓勵", "text": "有界線的投入，能讓你更安心地工作。" },
  { "id": "work-093", "category": "鼓勵", "text": "別急著否定自己，先看看是不是任務真的太多了。" },
  { "id": "work-094", "category": "鼓勵", "text": "在要求自己更好之前，先承認這段時間很辛苦。" },
  { "id": "work-095", "category": "鼓勵", "text": "今天有一件讓你鬆口氣的小事，也值得記住。" },
  { "id": "work-096", "category": "鼓勵", "text": "工作裡的小成就，不需要等到年末才慶祝。" },
  { "id": "work-097", "category": "鼓勵", "text": "即使今天只是平穩度過，也很好。" },
  { "id": "work-098", "category": "鼓勵", "text": "願你在處理事情的同時，也聽見自己的需要。" },
  { "id": "work-099", "category": "鼓勵", "text": "明天可以再調整，今天先給自己一點肯定。" },
  { "id": "work-100", "category": "鼓勵", "text": "小貓來提醒你：今天辛苦了，也記得把溫柔留一點給自己。" }
]
